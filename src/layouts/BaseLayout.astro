---
import "@fontsource-variable/sora/index.css";
import "@fontsource-variable/inter/index.css";
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import { profile } from "../data/profile";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, ogImage, structuredData } = Astro.props;

const resolvedOgImage = new URL(ogImage ?? "/images/og-image.png", Astro.site).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAlt = `${profile.name} — ${profile.role}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0D1B2E" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0D1B2E" />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <script is:inline>
      // Theme priority, checked in order: 1) saved localStorage preference,
      // 2) OS/browser prefers-color-scheme (dark or light, either one
      // honored as an explicit signal), 3) dark — used only when neither of
      // the above is available at all (e.g. localStorage blocked, or the
      // rare browser/OS that reports no preference either way). Runs
      // synchronously before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme;
          if (stored === "light" || stored === "dark") {
            theme = stored;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "dark";
          } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            theme = "light";
          } else {
            theme = "dark";
          }
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <p class="site-footer__copyright">© {new Date().getFullYear()} {profile.name}</p>
      <nav class="site-footer__links" aria-label="Footer">
        <a href={profile.links.email} aria-label={`Email ${profile.name}`}>
          <Icon name="lucide:mail" aria-hidden="true" />
        </a>
        <a href={profile.links.github} target="_blank" rel="noreferrer" aria-label={`${profile.name} on GitHub`}>
          <Icon name="simple-icons:github" aria-hidden="true" />
        </a>
        {profile.links.linkedin && (
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label={`${profile.name} on LinkedIn`}>
            <Icon name="simple-icons:linkedin" aria-hidden="true" />
          </a>
        )}
      </nav>
    </footer>
  </body>
</html>

<style>
  /* Flex-column body so a tall viewport with short page content still gets
     the footer pinned to the true bottom of the screen (via footer's
     margin-top: auto below) instead of it trailing right after the
     content. :global() on main because it's defined per-page (slotted in),
     not by this component, so a plain scoped selector wouldn't reach it. */
  body {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  body :global(main) {
    flex: 1;
  }

  /* Hidden below the "spacious" threshold (see global.css) on purpose —
     laptop-height viewports already fit their page content almost exactly,
     and adding footer height there would newly force a scroll that wasn't
     there before. It only appears where there's genuine leftover vertical
     room to spare. */
  .site-footer {
    display: none;
  }

  @media (min-width: 760px) and (min-height: 850px) {
    .site-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4) clamp(1rem, 3vw, 2rem);
      border-top: 1px solid var(--color-border);
      color: var(--color-text-muted);
      font-size: 0.85rem;
    }
  }

  .site-footer__copyright {
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-footer__links a {
    display: inline-flex;
    color: var(--color-text-muted);
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--color-accent-teal);
  }

  .site-footer__links :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }
</style>
