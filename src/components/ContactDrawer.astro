---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { profile } from "../data/profile";

// This component renders the drawer/backdrop only — the trigger buttons are
// separate components: <MenuTrigger /> (every page header, plain nav
// intent) and <ContactTrigger /> (only the Profile page's bottom "Contact
// me" CTA now), both opening this one shared drawer. The script below
// queries all [data-contact-trigger] buttons on the page.

interface Props {
  currentPage: "profile" | "experience" | "projects";
}

const { currentPage } = Astro.props;

// Same existence check as HeroCard's headshot — only render the image if
// the real file has actually been dropped in, no broken-image icon.
const headshotSrc = "/images/headshot.webp";
const hasHeadshot = fs.existsSync(path.join(process.cwd(), "public", headshotSrc));

// Deterministic two-line role, not incidental width-based wrapping — split
// on the first space so "Product-Minded Full-Stack Engineer" always breaks
// after "Product-Minded" regardless of drawer width.
const roleBreak = profile.role.indexOf(" ");
const roleLine1 = roleBreak === -1 ? profile.role : profile.role.slice(0, roleBreak);
const roleLine2 = roleBreak === -1 ? "" : profile.role.slice(roleBreak + 1);

const navItems = [
  { href: "/", label: "Dashboard", key: "dashboard" },
  { href: "/profile/", label: "Profile", key: "profile" },
  { href: "/projects/", label: "Projects", key: "projects" },
  { href: "/experience/", label: "Experience", key: "experience" },
] as const;
---
<div class="contact-drawer-backdrop" data-contact-backdrop hidden></div>

<div
  class="contact-drawer"
  id="contact-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Contact Jared Ryan"
  data-contact-drawer
  hidden
  tabindex="-1"
>
  <button type="button" class="contact-drawer__close" data-contact-close aria-label="Close contact drawer">
    <Icon name="lucide:x" aria-hidden="true" />
  </button>

  <div class="contact-drawer__contact" data-contact-section>
    <p class="eyebrow">Contact</p>

    <div class="contact-drawer__profile">
      {hasHeadshot && (
        <img class="contact-drawer__headshot" src={headshotSrc} alt="Jared Ryan" width="64" height="64" />
      )}
      <div>
        <p class="contact-drawer__name">{profile.name}</p>
        <p class="contact-drawer__role">{roleLine1}{roleLine2 && <><br />{roleLine2}</>}</p>
      </div>
    </div>

    <div class="contact-drawer__actions">
      <a class="btn btn--primary" href={profile.links.resume} download>
        <Icon name="lucide:download" aria-hidden="true" />
        Résumé
      </a>
      <a class="icon-btn" href={profile.links.email} aria-label="Email Jared Ryan">
        <Icon name="lucide:mail" aria-hidden="true" />
      </a>
      <a class="icon-btn" href={profile.links.github} target="_blank" rel="noreferrer" aria-label="Jared Ryan on GitHub">
        <Icon name="simple-icons:github" aria-hidden="true" />
      </a>
      {profile.links.linkedin && (
        <a class="icon-btn" href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="Jared Ryan on LinkedIn">
          <Icon name="simple-icons:linkedin" aria-hidden="true" />
        </a>
      )}
    </div>
  </div>

  <nav class="contact-drawer__nav" aria-label="Site sections">
    <p class="eyebrow">Navigation</p>
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.key === currentPage ? "page" : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .contact-drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 109;
    background: color-mix(in srgb, black 45%, transparent);
    opacity: 0;
    transition: opacity 240ms ease-out;
  }

  .contact-drawer-backdrop.is-open {
    opacity: 1;
  }

  .contact-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 110;
    width: min(330px, 90vw);
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    overflow-y: auto;
    transform: translateX(100%);
    opacity: 0;
    transition: transform 240ms ease-out, opacity 240ms ease-out;
  }

  .contact-drawer.is-open {
    transform: translateX(0);
    opacity: 1;
  }

  .contact-drawer__close {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
  }

  .contact-drawer__close :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .contact-drawer__close:hover,
  .contact-drawer__close:focus-visible {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  /* Wraps the "Contact" eyebrow + profile + actions as one section so it
     can be highlighted as a unit — see .is-contact-intent below — without
     touching the section's normal (non-highlighted) position: padding and
     the matching negative margin cancel out until the modifier adds them. */
  .contact-drawer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-radius: var(--radius-md);
    transition: background 200ms ease-out;
  }

  /* Set only when the drawer was opened via the explicit Contact trigger
     (ContactTrigger's data-contact-intent), cleared on close — see the
     script below. Cyan border matches every other hover/highlight border
     in the app (.icon-btn, .btn--outline, the drawer nav hover below); the
     surface-alt background is this section's own restrained fill, not
     borrowed from elsewhere. */
  .contact-drawer.is-contact-intent .contact-drawer__contact {
    background: var(--color-surface-alt);
    border: 1px solid var(--color-accent-teal);
    padding: var(--space-3);
    margin: calc(var(--space-3) * -1);
  }

  .contact-drawer__profile {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .contact-drawer__headshot {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  .contact-drawer__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
  }

  .contact-drawer__role {
    margin-top: var(--space-1);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.375em;
  }

  .contact-drawer__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* .btn/.btn--primary (global.css) cover the Résumé button above; .icon-btn
     (global.css) covers the email/GitHub/LinkedIn buttons above. */

  .contact-drawer__nav ul {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-drawer__nav a {
    display: block;
    padding: var(--space-2) var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }

  /* Same recipe as the site's other interactive buttons (.icon-btn,
     .btn--outline): border + text color only, no background swap. Text
     color already carries the contrast requirement on its own — layering a
     background shift on top too was pushing it further than any other
     hover state in the app. */
  .contact-drawer__nav a:hover,
  .contact-drawer__nav a:focus-visible {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  /* Orange counterpart to the hover treatment above, for the current page —
     declared after :hover so it wins on equal specificity and the "you are
     here" marker never gets masked by a hover pass over it. */
  .contact-drawer__nav a[aria-current="page"] {
    border-color: var(--color-accent-coral);
    color: var(--color-accent-coral-text);
  }
</style>

<script>
  // Each page renders exactly one drawer, but Projects has multiple trigger
  // buttons in the DOM at once (the grid view's MenuTrigger plus one per
  // project detail view — only one of those is ever visible/reachable at a
  // time, per ProjectsSection's grid/detail `hidden` toggle). Track
  // whichever one was actually clicked so focus returns to that specific
  // button, not just "the first trigger in the DOM" (which could be hidden).
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-contact-trigger]");
  const drawer = document.querySelector<HTMLElement>("[data-contact-drawer]");
  const backdrop = document.querySelector<HTMLElement>("[data-contact-backdrop]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-contact-close]");
  let lastTrigger: HTMLElement | null = null;

  function getFocusable(): HTMLElement[] {
    if (!drawer) return [];
    return Array.from(drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));
  }

  function onKeydown(event: KeyboardEvent) {
    if (event.key === "Escape") {
      closeDrawer();
      return;
    }
    if (event.key !== "Tab") return;
    const focusable = getFocusable();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    // Trap focus inside the drawer while it's open.
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  let openFrameId: number | null = null;

  function openDrawer(event: Event) {
    if (!drawer || !backdrop) return;
    lastTrigger = event.currentTarget as HTMLElement;
    // Only the explicit Contact trigger (ContactTrigger.astro) carries
    // data-contact-intent — the hamburger menu trigger doesn't, so opening
    // via the menu leaves the CONTACT section in its normal, unemphasized
    // state. This is transient intent, not a persisted selection: it's
    // cleared in closeDrawer() below so a later hamburger-open always
    // starts from the normal state regardless of how the drawer was last
    // opened.
    drawer.classList.toggle("is-contact-intent", lastTrigger.hasAttribute("data-contact-intent"));
    drawer.hidden = false;
    backdrop.hidden = false;
    // Force layout before adding the open class so the transform/opacity
    // transition has a committed starting state to animate from — same
    // technique used for the Experience accordion panel elsewhere in the
    // codebase.
    void drawer.offsetWidth;
    openFrameId = requestAnimationFrame(() => {
      openFrameId = null;
      drawer.classList.add("is-open");
      backdrop.classList.add("is-open");
    });
    document.addEventListener("keydown", onKeydown);
    const focusable = getFocusable();
    (focusable[0] ?? drawer).focus();
  }

  function closeDrawer() {
    if (!drawer || !backdrop) return;
    document.removeEventListener("keydown", onKeydown);
    (lastTrigger ?? triggers[0])?.focus();
    drawer.classList.remove("is-contact-intent");
    // If close happens before the opening frame ever ran (e.g. closed
    // immediately after opening), .is-open was never added, so removing it
    // triggers no transition and transitionend would never fire — cancel
    // the pending frame and hide immediately instead of waiting forever.
    if (openFrameId !== null) {
      cancelAnimationFrame(openFrameId);
      openFrameId = null;
      drawer.hidden = true;
      backdrop.hidden = true;
      return;
    }
    if (!drawer.classList.contains("is-open")) {
      drawer.hidden = true;
      backdrop.hidden = true;
      return;
    }
    drawer.classList.remove("is-open");
    backdrop.classList.remove("is-open");
    const onEnd = (event: TransitionEvent) => {
      if (event.propertyName !== "transform") return;
      drawer.removeEventListener("transitionend", onEnd);
      // Guards against a stale listener firing after a rapid re-open.
      if (!drawer.classList.contains("is-open")) {
        drawer.hidden = true;
        backdrop.hidden = true;
      }
    };
    drawer.addEventListener("transitionend", onEnd);
  }

  triggers.forEach((trigger) => trigger.addEventListener("click", openDrawer));
  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
</script>
