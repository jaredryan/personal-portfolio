  }

  .profile-summary-column:nth-child(1) { animation-delay: 60ms; }
  .profile-summary-column:nth-child(2) { animation-delay: 140ms; }
  .profile-summary-column:nth-child(3) { animation-delay: 220ms; }

  .profile-summary-column h3 {
    font-size: 1.05rem;
  }

  .profile-summary-column p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.5;
  }

  @media (min-width: 760px) {
    .profile-summary-columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .profile-summary-column {
      padding-top: 0;
      padding-inline: var(--space-6);
      border-top: none;
      border-left: 1px solid var(--color-border);
    }

    .profile-summary-column:first-child {
      padding-left: 0;
      border-left: none;
    }
  }

  .profile-closing {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .profile-closing__actions {
