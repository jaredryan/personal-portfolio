---
import fs from "node:fs";
import path from "node:path";
import ContactDrawer from "./ContactDrawer.astro";
import ContactTrigger from "./ContactTrigger.astro";
import PageHeader from "./PageHeader.astro";
import { profile } from "../data/profile";
import { profileNarrative } from "../data/profileNarrative";
import { projects } from "../data/projects";

// Same existence check HeroCard/ContactDrawer use for the optional headshot
// — a collage tile renders the real photo the instant one is dropped at the
// given path, no code change needed, and falls back to a typeset name tile
// until then (see CLAUDE.md's placeholder-not-blocker guidance).
function assetExists(relPath: string): boolean {
  return fs.existsSync(path.join(process.cwd(), "public", relPath));
}

// Same asset already used by HeroCard's identity row and ContactDrawer's
// profile block — the opening lead reuses it rather than requiring a new
// portrait (see CLAUDE.md's placeholder-not-blocker guidance).
const headshotSrc = "/images/headshot.webp";
const hasHeadshot = assetExists(headshotSrc);

type Accent = "primary" | "teal" | "coral" | "sand";
type RawTile = {
  name: string;
  src: string;
  /** Theme-swapped variant (same technique as ThemeToggle's sun/moon icons)
   * — only meaningful once `src` itself resolves to a real file. */
  srcDark?: string;
  /** True for a wordmark/logo (contain + padded background) as opposed to a
   * photograph/screenshot (cover, edge-to-edge — the default). */
  logo?: boolean;
  /** Fixed light backing regardless of theme, for a logo that only has one
   * (dark-on-transparent) version — same fix already applied to the
   * Experience page's own company logos (img.experience-preview__logo). */
  plate?: boolean;
  /** Placeholder tint, used only while no real image exists yet. */
  accent?: Accent;
  /** Responsive srcset — only worth the extra request for a genuinely large
   * photo (Ryan Lin REI's 992w original); the logo files are already a few
   * KB each as a single lossless WebP, so a second size would cost more in
   * request overhead than it'd ever save. */
  srcset?: string;
  sizes?: string;
  /** Caption rendered beneath this tile when it's shown as a standalone
   * editorial figure (chapter 2's "single" layout only — quad/feature tiles
   * ignore this). */
  caption?: string;
};
type CollageTile = RawTile & { hasImage: boolean; hasDarkImage: boolean };

function resolveTile(tile: RawTile): CollageTile {
  return {
    ...tile,
    hasImage: assetExists(tile.src),
    hasDarkImage: Boolean(tile.srcDark) && assetExists(tile.srcDark!),
  };
}

function tileClasses(tile: CollageTile): string {
  const classes = ["profile-collage-tile"];
  if (tile.hasImage) {
    if (tile.logo) classes.push("profile-collage-tile--logo");
    if (tile.plate) classes.push("profile-collage-tile--plate");
  } else if (tile.accent) {
    classes.push(`profile-collage-tile--${tile.accent}`);
  }
  return classes.join(" ");
}

const projectCover = (slug: string) => projects.find((p) => p.slug === slug)!.screenshots.cover;

const chapter1Tiles: RawTile[] = [
  {
    name: "UC Berkeley",
    src: "/images/journey/uc-berkeley-light.webp",
    srcDark: "/images/journey/uc-berkeley-dark.webp",
    logo: true,
    accent: "primary",
  },
  {
    name: "V School",
    src: "/images/journey/v-school.webp",
    srcDark: "/images/journey/v-school-dark.webp",
    logo: true,
    accent: "teal",
  },
  {
    name: "IBM",
    src: "/images/journey/ibm-light.svg",
    srcDark: "/images/journey/ibm-dark.svg",
    logo: true,
    accent: "coral",
  },
  {
    name: "MANTL",
    src: "/images/journey/mantl-light.webp",
    srcDark: "/images/journey/mantl-dark.webp",
    logo: true,
    accent: "sand",
  },
];

const chapter2Tiles: RawTile[] = [
  {
    name: "Ryan Lin REI, LLC",
    src: "/images/journey/ryan-lin-rei.webp",
    srcset: "/images/journey/ryan-lin-rei-640.webp 640w, /images/journey/ryan-lin-rei.webp 992w",
    // Matches this figure's actual rendered width at each breakpoint — see
    // .profile-journey__media[data-layout="single"]'s max-width rules below.
    sizes: "(min-width: 900px) 480px, min(448px, 90vw)",
    accent: "sand",
    caption: "Residential real estate operations, 2022–present",
  },
];

// Chapter 3 already has real screenshots (no placeholder needed), so its
// tiles skip resolveTile/assetExists and just declare hasImage: true directly.
const chapter3Tiles: CollageTile[] = [
  { name: "Campfire", src: projectCover("campfire"), hasImage: true, hasDarkImage: false },
  { name: "Ryan Legal, PC", src: projectCover("ryan-legal-pc"), hasImage: true, hasDarkImage: false },
  { name: "LPA Tracker", src: projectCover("lpa-tracker"), hasImage: true, hasDarkImage: false },
];

// One media block per journey chapter, in chapter order. Layout follows the
// number of real named entities each chapter's own copy mentions — 4 for
// chapter 1 (an even quad), 1 for chapter 2 (a single standalone frame,
// fitting since it's already the narrative's own outlier), 3 for chapter 3
// (a featured top tile + two supporting tiles). Chapter 1 and 2 render as
// typeset placeholders until real photos land at the paths above; chapter 3
// ships as real images now.
//
// Visual weight is deliberately unequal across the three, matching the
// story's own arc: chapter 1's logos are supporting orientation, chapter 2's
// photo is documentary evidence, chapter 3's collage is the strongest
// evidence of current direction and gets the richest treatment (see the
// per-layout sizing rules in the <style> block below).
const chapterMedia: { layout: "quad" | "single" | "feature"; tiles: CollageTile[] }[] = [
  { layout: "quad", tiles: chapter1Tiles.map(resolveTile) },
  { layout: "single", tiles: chapter2Tiles.map(resolveTile) },
  { layout: "feature", tiles: chapter3Tiles },
];

const journeyRows = profileNarrative.chapters.map((chapter, index) => ({
  chapter,
  media: chapterMedia[index],
}));
---
<section class="profile-section page-shell" aria-labelledby="profile-heading">
  <PageHeader
    breadcrumbLabel="Profile"
    eyebrow={profileNarrative.pageLabel}
    heading={profileNarrative.heading}
    headingId="profile-heading"
    icon="lucide:compass"
  />

  <div class="profile-content">
    <div class="profile-opening">
      <div class="profile-opening__left">
        {hasHeadshot && (
          <img
            class="profile-opening__photo"
            src={headshotSrc}
            alt="Jared Ryan"
            width="112"
            height="112"
            loading="eager"
          />
        )}
        <p class="profile-opening__para">{profileNarrative.intro[0]}</p>
      </div>
      <div class="profile-opening__right">
        <p class="profile-opening__lead">{profileNarrative.openingLead}</p>
        <p class="profile-opening__para">{profileNarrative.intro[1]}</p>
      </div>
    </div>

    <section class="profile-journey-section" aria-labelledby="profile-journey-heading">
      <h2 id="profile-journey-heading">{profileNarrative.journeyHeading}</h2>
      <ol class="profile-journey">
        {journeyRows.map(({ chapter, media }) => (
          <li class="profile-journey__chapter">
            <span class="profile-journey__number" aria-hidden="true">{chapter.number}</span>
            <div class="profile-journey__row">
              <div class="profile-journey__text">
                <h3>{chapter.heading}</h3>
                {chapter.body.map((paragraph) => (
                  <p class="prose">{paragraph}</p>
                ))}
              </div>

              {media.layout === "single" ? (
                <div class="profile-journey__media" data-layout="single">
                  {media.tiles.map((tile) => (
                    <figure class="profile-journey__figure">
                      <div class="profile-journey__figure-frame">
                        {tile.hasImage ? (
                          <img
                            class="profile-journey__figure-img"
                            src={tile.src}
                            srcset={tile.srcset}
                            sizes={tile.sizes}
                            alt="Aerial view of a single-family rental property"
                            loading="lazy"
                          />
                        ) : (
                          <span class="profile-collage-tile__placeholder">{tile.name}</span>
                        )}
                      </div>
                      {tile.caption && <figcaption class="profile-journey__caption">{tile.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              ) : (
                <div class="profile-journey__media" data-layout={media.layout}>
                  <div class="profile-journey__tile-grid">
                    {media.tiles.map((tile) => (
                      <div class={tileClasses(tile)}>
                        {tile.hasImage ? (
                          tile.hasDarkImage ? (
                            <>
                              <img class="profile-collage-tile__img profile-collage-tile__img--light" src={tile.src} srcset={tile.srcset} sizes={tile.sizes} alt={tile.name} loading="lazy" />
                              <img class="profile-collage-tile__img profile-collage-tile__img--dark" src={tile.srcDark} srcset={tile.srcset} sizes={tile.sizes} alt={tile.name} loading="lazy" />
                            </>
                          ) : (
                            <img class="profile-collage-tile__img" src={tile.src} srcset={tile.srcset} sizes={tile.sizes} alt={tile.name} loading="lazy" />
                          )
                        ) : (
                          <span class="profile-collage-tile__placeholder">{tile.name}</span>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="profile-summary-section" aria-labelledby="profile-values-heading">
      <div class="profile-summary-band">
        <h2 id="profile-values-heading">{profileNarrative.valuesHeading}</h2>
        <div class="profile-summary-columns">
          {profileNarrative.values.map((value) => (
            <div class="profile-summary-column">
              <h3>{value.heading}</h3>
              <p>{value.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="profile-closing" aria-label="Get in touch">
      <p class="profile-closing__text prose">{profileNarrative.closing}</p>
      <div class="profile-closing__actions">
        <a class="btn btn--primary" href="/projects">{profileNarrative.closingActions.viewProjects}</a>
        <a class="btn btn--outline" href="/experience">{profileNarrative.closingActions.viewExperience}</a>
        <a class="btn btn--outline" href={profile.links.resume} download>{profileNarrative.closingActions.resume}</a>
        <ContactTrigger label={profileNarrative.closingActions.contact} />
      </div>
    </section>
  </div>

  <ContactDrawer currentPage="profile" />
</section>

<style>
  .profile-content {
    /* Shared with .profile-journey__chapter's marker column below. */
    --journey-rail: 2rem;
    --journey-rail-gap: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    /* Muted page-entry motion: transform + opacity only, no layout shift.
       prefers-reduced-motion is handled globally (global.css clamps every
       animation-duration to ~0), so no local override is needed here — same
       convention BentoDashboard.astro's entrance animation relies on. */
    animation: profile-enter 420ms ease-out both;
  }

  @keyframes profile-enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------------------------------------------------------------------
     Opening — full-width two-column introduction directly beneath the
     shared PageHeader, once there's room (see the two-column media query
     below). Left column: modest circular portrait beside paragraph 1.
     Right column: the elevated sentence, then paragraph 2. Below the
     two-column breakpoint, collapse is classic text wrap rather than a
     stacked photo-then-paragraph block: the portrait floats to the inline
     start of paragraph 1 and the text wraps around it, same as any
     figure-in-a-paragraph pattern — DOM order (photo, paragraph 1,
     elevated sentence, paragraph 2) is untouched either way, only the CSS
     positioning changes. */
  .profile-opening {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* flow-root (not the block default) so this container's own height
     properly includes the floated photo — without it, a block box can
     collapse to shorter than its floated children per spec, which would
     let the float visually spill into .profile-opening__right below. */
  .profile-opening__left {
    display: flow-root;
  }

  .profile-opening__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    /* Belt-and-suspenders alongside .profile-opening__left's flow-root
       above: guarantees the elevated sentence always starts below the
       floated portrait, never beside it, even if a future change removes
       the flow-root containment. clear has no effect once this becomes a
       grid item at the two-column breakpoint, so it's safe to leave on. */
    clear: both;
  }

  /* One fixed size for the whole floated/wrapped range (below the
     two-column breakpoint) rather than stepping down at narrower widths —
     kept at the same size the row layout used to grow into at 640px, so it
     no longer visibly shrinks as the viewport narrows past 640px/400px. */
  .profile-opening__photo {
    float: inline-start;
    margin-inline-end: var(--space-4);
    margin-bottom: var(--space-3);
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
  }

  /* Same body typography as the journey narrative (Register 2) rather than
     the tighter default paragraph line-height. */
  .profile-opening__para {
    line-height: 1.65;
  }

  /* Restrained editorial callout, not a second heading: a thin inline-start
     rule in the same coral already used to mark something notable
     elsewhere on this page (the chapter-number rings, the eyebrow dot) —
     reusing that accent rather than introducing a new one. Border-only, no
     background tint or padding-block, so it reads as a pull-quote cue
     belonging to the paragraph flow, not a boxed/alert-style container. */
  .profile-opening__lead {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    border-inline-start: 3px solid var(--color-accent-coral);
    padding-inline-start: var(--space-4);
  }

  @media (min-width: 640px) {
    .profile-opening__lead {
      font-size: 1.375rem;
    }
  }

  /* Two-column desktop layout: left column becomes a row (portrait top-
     aligned beside paragraph 1, which takes the remaining space, no longer
     floated — float/clear are ignored on flex items per spec, but display:
     flex here is what actually drives the row); right column stays a stack
     (elevated sentence, then paragraph 2). */
  @media (min-width: 900px) and (min-aspect-ratio: 3/4) {
    .profile-opening {
      display: grid;
      /* Left column takes whatever space is left over; the right column is
         sized to exactly match .profile-journey__row's own right-hand
         column below — that row's available width is the page-shell width
         minus the rail+gap, split in half minus half the column-gap, so
         reproducing that same formula here (against this container's own
         100%, not a padding-shifted width) lands the two right edges/
         widths exactly together without moving or narrowing the left
         column at all. */
      grid-template-columns:
        minmax(0, 1fr)
        calc(50% - (var(--journey-rail) + var(--journey-rail-gap) + var(--space-6)) / 2);
      align-items: start;
      gap: var(--space-6);
    }

    .profile-opening__left {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .profile-opening__photo {
      float: none;
      margin: 0;
      width: 112px;
      height: 112px;
    }

    .profile-opening__para {
      min-width: 0;
    }
  }

  .profile-journey-section h2,
  .profile-summary-band h2 {
    margin-bottom: var(--space-6);
  }

  /* Restrained "chapter rail": a vertical line running through the center of
     each chapter's numbered marker. The line is a single absolutely
     positioned element on the list itself (not per-chapter), so it reads as
     one continuous path rather than three disconnected segments. Always a
     single column, at every viewport width — the brief explicitly rules out
     an alternating left/right layout, so this never introduces one. */
  .profile-journey {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .profile-journey::before {
    content: "";
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    /* Centers on the 2rem marker column: (2rem - 2px) / 2. */
    left: calc(1rem - 1px);
    width: 2px;
    background: var(--color-border);
  }

  .profile-journey__chapter {
    display: grid;
    grid-template-columns: var(--journey-rail) 1fr;
    column-gap: var(--journey-rail-gap);
    row-gap: var(--space-2);
    animation: profile-enter 420ms ease-out both;
  }

  .profile-journey__chapter:nth-child(1) { animation-delay: 60ms; }
  .profile-journey__chapter:nth-child(2) { animation-delay: 140ms; }
  .profile-journey__chapter:nth-child(3) { animation-delay: 220ms; }

  /* Grid auto-placement (default "sparse" packing) puts the number in the
     open column-1 cell on row 1, then each explicitly column-2 element
     (heading, then each paragraph) fills the next free row in column 2 —
     no manual row indices needed, and it keeps the number pinned next to
     the heading regardless of how many paragraphs follow. */
  .profile-journey__number {
    grid-column: 1;
    position: relative;
    width: var(--journey-rail);
    height: var(--journey-rail);
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent-coral);
    color: var(--color-accent-coral-text);
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* The row wrapper is the only other direct child of .profile-journey__chapter
     (marker occupies column 1 explicitly) — default grid auto-placement puts
     it in column 2 with no explicit rule needed.

     Source/reading order inside is always number -> heading -> narrative ->
     media (see the markup above); below the two-column breakpoint this is
     also the visual order — no `order` property reorders media ahead of
     text the way the previous version did. */
  .profile-journey__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Register 2 (journey narrative): a modest step up from ordinary body
     copy, with a slightly more generous line-height than interface text and
     a heading that's clearly distinct from — but not competing with — the
     opening lead above. */
  .profile-journey__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .profile-journey__text h3 {
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .profile-journey__text p {
    line-height: 1.65;
  }

  @media (max-width: 759.98px) {
    .profile-journey__text h3 {
      font-size: 1.15rem;
    }
  }

  /* -----------------------------------------------------------------------
     Media — stacked (default) sizing. Each chapter gets its own absolute,
     width-independent cap (max-width + aspect-ratio) rather than a square
     tied to the full column width, so none of them can turn into a "wall"
     of imagery on a wide-but-still-single-column tablet. Heights are
     deliberately unequal and increase from chapter 1 -> 3, matching the
     story's own arc (supporting orientation -> documentary evidence ->
     strongest current-direction evidence).
     ----------------------------------------------------------------------- */
  .profile-journey__media {
    width: 100%;
  }

  .profile-journey__tile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--space-2);
    width: 100%;
    height: 100%;
  }

  /* Chapter 1 — stacked/mobile only: capped independent of column width so
     it can never become a "wall" of logos on a wide-but-still-single-column
     tablet, but no longer forced into a tiny square either. Width caps at
     chapter 3's own max-width (34rem); aspect-ratio: 16/10 (chapter 2's
     ratio) lets it scale fluidly with the viewport up to chapter 2's own
     effective height (28rem at 16/10 = 17.5rem), where max-height then
     takes over as a guardrail — same "aspect-ratio + max-height guardrail"
     pattern the two-column media query already uses below, just applied
     here in stacked mode. This cap is removed entirely in two-column mode
     (see that media query), where the grid instead fills the whole media
     column. */
  .profile-journey__media[data-layout="quad"] {
    max-width: 34rem;
    max-height: 17.5rem;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    min-height: 0;
    position: relative;
  }

  /* Chapter 2 — moderate landscape figure, shorter than a square block at
     every width. */
  .profile-journey__media[data-layout="single"] {
    max-width: 28rem;
  }

  .profile-journey__figure {
    margin: 0;
  }

  .profile-journey__figure-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    /* Subtle separation only — deliberately lighter than the logo tiles'
       chrome so a real photograph doesn't read as another placeholder
       tile/symbol. */
    border: 1px solid var(--color-border);
    aspect-ratio: 16 / 10;
  }

  .profile-journey__figure-frame > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .profile-journey__figure-img {
    object-fit: cover;
  }

  .profile-journey__caption {
    margin: var(--space-2) 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: left;
  }

  /* Chapter 3 — richest of the three, still bounded on tablets/phones so it
     can never overflow or dominate a short viewport. */
  .profile-journey__media[data-layout="feature"] {
    position: relative;
    max-width: 34rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    min-height: 0;
  }

  /* Scoped to "feature" only (chapter 3) — the first tile spans the full top
     row there, but chapter 1's quad grid uses the same .profile-journey__tile-grid
     wrapper and must stay a plain, unspanned 2x2. */
  .profile-journey__media[data-layout="feature"] .profile-collage-tile:first-child {
    grid-column: 1 / -1;
  }

  .profile-collage-tile {
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    min-height: 0;
    min-width: 0;
  }

  .profile-collage-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Logo/wordmark tiles: the mark is never cropped (contain, not cover) and
     sits on a padded background, unlike the photographic screenshot tiles
     (chapter 3) which fill the tile edge-to-edge via the cover rule above.
     Tiles now fill the full media column on desktop (see the two-column
     media query below), so there's room for proper breathing room again. */
  .profile-collage-tile--logo {
    background: var(--color-surface-alt);
    padding: var(--space-4);
  }

  .profile-collage-tile--logo .profile-collage-tile__img {
    object-fit: contain;
  }

  .profile-collage-tile--plate {
    background: var(--color-logo-plate);
  }

  /* Theme-swapped logo variant — same show/hide technique ThemeToggle.astro
     uses for its sun/moon icons. Only rendered when a tile actually supplies
     both a light and dark asset (see hasDarkImage). */
  .profile-collage-tile__img--dark {
    display: none;
  }

  :global([data-theme="dark"]) .profile-collage-tile__img--light {
    display: none;
  }

  :global([data-theme="dark"]) .profile-collage-tile__img--dark {
    display: block;
  }

  .profile-collage-tile__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.85rem;
    line-height: 1.2;
  }

  /* Placeholder tint rotates through the site's own accent tokens (same
     color-mix formula .pill/.projects-preview__thumb already use) rather
     than each entity's real brand color — keeps every "not sourced yet"
     tile inside this page's own palette instead of a mismatched preview of
     colors that aren't final. */
  .profile-collage-tile--primary .profile-collage-tile__placeholder {
    background: color-mix(in srgb, var(--color-primary) 12%, var(--color-surface-alt));
    color: var(--color-primary);
  }

  .profile-collage-tile--teal .profile-collage-tile__placeholder {
    background: color-mix(in srgb, var(--color-accent-teal) 16%, var(--color-surface-alt));
    color: var(--color-accent-teal);
  }

  .profile-collage-tile--coral .profile-collage-tile__placeholder {
    background: color-mix(in srgb, var(--color-accent-coral) 16%, var(--color-surface-alt));
    color: var(--color-accent-coral-text);
  }

  .profile-collage-tile--sand .profile-collage-tile__placeholder {
    background: color-mix(in srgb, var(--color-accent-sand) 28%, var(--color-surface-alt));
    color: var(--color-text);
  }

  /* -----------------------------------------------------------------------
     Two-column layout. Gated by width AND shape (not width alone) — same
     idiom BentoDashboard/ExperienceSection already use elsewhere on this
     site so a wide-but-still-portrait tablet doesn't get squeezed into a
     layout meant for landscape viewports. 900px is where a 1fr/1fr split of
     the rail-offset content column first clears a comfortable ~380px
     reading width per side; 3/4 keeps a tall, narrow-ish window (portrait
     tablets/some split-screen layouts) out of the two-column tier even past
     that width floor.

     The actual height fix lives here too: instead of an aspect-ratio tied
     to the (variable-width) media column, the row becomes a grid with
     `align-items: stretch` and the text column's own content sets the auto
     row height. Chapters 2 and 3's media wrappers contribute no intrinsic
     height of their own (their visible content is absolutely positioned
     inside a zero-height wrapper — see .profile-journey__figure-frame and
     .profile-journey__tile-grid overrides below), so the resolved row
     height comes from the text column alone, and stretch then fills the
     media column to match it exactly — media can no longer end up taller
     OR shorter than its own chapter's text purely because the column got
     wider or narrower. min/max-height below are guardrails for unusually
     short/long chapter text, not the primary sizing mechanism. */
  @media (min-width: 900px) and (min-aspect-ratio: 3/4) {
    .profile-journey__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "text media";
      align-items: stretch;
      column-gap: var(--space-6);
    }

    .profile-journey__text {
      grid-area: text;
    }

    .profile-journey__media {
      grid-area: media;
      min-width: 0;
      min-height: 0;
    }

    /* Chapter 2 (the narrative's own outlier) alternates to media-left/
       text-right purely via grid-template-areas — DOM order is unchanged
       (text still precedes media in the markup), so reading/tab order stays
       text-then-media regardless of this purely visual flip. */
    .profile-journey__chapter:nth-child(2) .profile-journey__row {
      grid-template-areas: "media text";
    }

    /* Chapter 1 now fills the full media column instead of floating as a
       small centered block — width comes from the grid area (default
       justify-self: stretch, once the stacked-mode cap below is lifted);
       height comes from align-self: stretch, matching the text-defined row
       height exactly like chapters 2/3 (see the tile-grid override below
       for how it avoids contributing its own intrinsic height). */
    .profile-journey__media[data-layout="quad"] {
      max-width: none;
      aspect-ratio: auto;
      align-self: stretch;
    }

    /* Chapters 2 and 3: let the row's own stretched height govern instead
       of a width-derived aspect-ratio. */
    .profile-journey__media[data-layout="single"] {
      max-width: none;
      align-self: stretch;
      min-height: 10rem;
      max-height: 26rem;
    }

    .profile-journey__figure {
      display: flex;
      flex-direction: column;
      height: 100%;
      gap: var(--space-2);
    }

    .profile-journey__figure-frame {
      flex: 1 1 auto;
      min-height: 0;
      aspect-ratio: auto;
    }

    .profile-journey__media[data-layout="feature"] {
      max-width: none;
      aspect-ratio: auto;
      align-self: stretch;
      min-height: 12rem;
      /* Comfortably above chapter 3's own text height at every tested
         two-column width (including the narrowest, where its 3-paragraph
         body wraps tallest) — a true guardrail against pathological content
         lengths, not a value that's meant to actually bind day to day. */
      max-height: 42rem;
    }

    /* Explicitly scoped to feature AND quad (both now stretch-fill their
       column) rather than a bare .profile-journey__tile-grid selector —
       both wrappers are position: relative with a resolved size from
       align-self: stretch, so inset: 0 here fills each one's own parent
       correctly. A bare, unscoped selector previously caused this rule to
       escape to a distant positioned ancestor instead (see git history) —
       keep this list explicit rather than reverting to that. */
    .profile-journey__media[data-layout="feature"] .profile-journey__tile-grid,
    .profile-journey__media[data-layout="quad"] .profile-journey__tile-grid {
      position: absolute;
      inset: 0;
    }
  }

  /* -----------------------------------------------------------------------
     Summary — "What I bring now" as a restrained alternate-background band
     rather than three individual icon cards. Register 3 of the page's type
     system: more compact than the journey narrative, reading as synthesis
     rather than another chapter.
     ----------------------------------------------------------------------- */
  .profile-summary-band {
    background: var(--color-surface-alt);
    border-radius: var(--radius-md);
    padding: var(--space-8) var(--space-6);
