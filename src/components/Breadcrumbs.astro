---
import { Icon } from "astro-icon/components";

type Crumb = {
  label: string;
  href?: string;
  clearProject?: boolean;
};

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {trail.map((crumb, index) => {
      const isCurrent = index === trail.length - 1;
      return (
        <li>
          {isCurrent ? (
            <span aria-current="page">{crumb.label}</span>
          ) : (
            <a
              href={crumb.href ?? "#"}
              data-clear-project={crumb.clearProject ? "" : undefined}
            >
              {crumb.label}
            </a>
          )}
          {!isCurrent && <Icon name="lucide:chevron-right" aria-hidden="true" class="breadcrumbs__sep" />}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent-teal);
    text-decoration: underline;
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  /* var(--color-text-muted), not var(--color-border) — the border color is
     too low-contrast against the page background to read as a visible
     separator, it was basically invisible in both themes. */
  .breadcrumbs__sep {
    width: 0.9em;
    height: 0.9em;
    color: var(--color-text-muted);
  }

</style>
