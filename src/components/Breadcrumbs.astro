---
import { Icon } from "astro-icon/components";

type Crumb = {
  label: string;
  href?: string;
  clearProject?: boolean;
};

interface Props {
  trail: Crumb[];
}

const { trail } = Astro.props;
---
<nav aria-label="Breadcrumb" class="breadcrumbs">
  <ol>
    {trail.map((crumb, index) => {
      const isCurrent = index === trail.length - 1;
      return (
        <li>
          {isCurrent ? (
            <span aria-current="page">{crumb.label}</span>
          ) : (
            <a
              href={crumb.href ?? "#"}
              data-clear-project={crumb.clearProject ? "" : undefined}
            >
              {crumb.label}
            </a>
          )}
          {!isCurrent && <Icon name="lucide:chevron-right" aria-hidden="true" class="breadcrumbs__sep" />}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  /* Ancestor crumbs read as links (primary-blue + underline) at every
     breakpoint, not just on hover — otherwise they look like passive
     location labels. Padding enlarges the touch target to a comfortable
     size without the visible text becoming button-sized; deliberately no
     compensating negative margin, so adjacent crumbs' hit areas stay
     separated by the padding plus the row's existing gap, never touching. */
  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1.5px;
    padding: 0.2rem 0.35rem 0.2rem 0;
    border-radius: var(--radius-sm);
  }

  .breadcrumbs a:hover,
  .breadcrumbs a:focus-visible {
    color: var(--color-accent-teal);
  }

  .breadcrumbs [aria-current="page"] {
    color: var(--color-text);
    font-weight: 600;
  }

  /* var(--color-text-muted), not var(--color-border) — the border color is
     too low-contrast against the page background to read as a visible
     separator, it was basically invisible in both themes. */
  .breadcrumbs__sep {
    width: 0.9em;
    height: 0.9em;
    color: var(--color-text-muted);
  }

</style>
