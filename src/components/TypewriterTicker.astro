---
interface Props {
  label: string;
  lines: string[];
  /** Hidden lines queued in on click/tap/keyboard-activation — never part
   * of the automatic rotation, so they still need to be included below in
   * the sizer pass (otherwise showing one would jitter the reserved
   * height), but not in the visible/live rotation markup. */
  bonusLines?: string[];
}

const { label, lines, bonusLines = [] } = Astro.props;
const sizerLines = [...lines, ...bonusLines];
const buttonLabel = `${label.replace(/:$/, "")} ticker — activate for a bonus line`;
---
<button
  type="button"
  class="typewriter"
  data-lines={JSON.stringify(lines)}
  data-bonus-lines={JSON.stringify(bonusLines)}
  aria-label={buttonLabel}
>
  <div class="typewriter__stage">
    {sizerLines.map((line) => (
      // Trailing "|" mirrors the live cursor glyph appended after a fully
      // typed line during its hold — without it, the sizer under-reserves
      // by exactly the cursor's width and the real cursor can wrap onto an
      // extra line the grid track never accounted for. The label is
      // repeated inline here (hidden) so the sizer wraps exactly like the
      // live line — label + sentence sharing one inline flow, not a
      // separate column.
      <span class="typewriter__sizer-line" aria-hidden="true"><span class="typewriter__label">{label}</span>{line}|</span>
    ))}
    <span class="typewriter__line"><span class="typewriter__label" aria-hidden="true">{label}</span><span class="typewriter__text" aria-live="polite">{lines[0]}</span><span class="typewriter__cursor" aria-hidden="true">|</span></span>
  </div>
</button>

<style>
  /* A quiet "status/log" treatment, not a fake terminal — just monospace
     type and a hint of tinted surface, confined to this one element.
     Real <button> underneath a hidden click easter egg — deliberately not
     styled as an obvious button (no hover state, no border change) so it
     stays a quiet, slightly-hidden affordance rather than an advertised
     control. cursor: pointer is the only hint. */
  .typewriter {
    appearance: none;
    width: 100%;
    margin: 0;
    border: none;
    text-align: left;
    cursor: pointer;
    display: block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    min-height: 1.5em;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface-alt);
    border-radius: var(--radius-sm);
  }

  /* Subtle acknowledgement pulse for the first two accepted clicks only —
     a brief teal tint, not a persistent style change. */
  @keyframes typewriter-pulse {
    0%, 100% { background-color: var(--color-surface-alt); }
    40% { background-color: color-mix(in srgb, var(--color-accent-teal) 18%, var(--color-surface-alt)); }
  }

  .typewriter--pulse {
    animation: typewriter-pulse 700ms ease-out;
  }

  .typewriter__label {
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    margin-right: var(--space-2);
  }

  /* Grid-overlay sizer: every phrase (hidden) and the live typed line all
     share grid-area 1/1, so the track height the grid reserves is the
     tallest single phrase's wrapped height — not the sum of every phrase's
     height, and not a hardcoded line-count guess. This is what stops the
     bento cards below from bouncing as the ticker cycles through phrases
     of different lengths. Each grid item is blockified by the grid layout,
     so the label + sentence inside it wrap as normal inline text using the
     stage's full width — not a separate flex column. */
  .typewriter__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .typewriter__stage > * {
    grid-area: 1 / 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* Occupies layout (for height reservation) but never paints and is
     pulled from the accessibility tree, so screen readers only ever hear
     the single live `aria-live` line, not every phrase at once. */
  .typewriter__sizer-line {
    visibility: hidden;
  }

  .typewriter__cursor {
    color: var(--color-accent-coral);
    animation: blink 1s step-end infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter__cursor {
      animation: none;
    }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>

<script>
  const root = document.querySelector<HTMLButtonElement>(".typewriter");
  const textEl = root?.querySelector<HTMLElement>(".typewriter__text");
  const cursorEl = root?.querySelector<HTMLElement>(".typewriter__cursor");
  const lines: string[] = JSON.parse(root?.dataset.lines ?? "[]");
  const bonusLines: string[] = JSON.parse(root?.dataset.bonusLines ?? "[]");

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && textEl && lines.length > 0 && !prefersReducedMotion) {
    const TYPE_MS = 35;
    const DELETE_MS = 18;
    const HOLD_MS = 1800;
    let lineIndex = 0;
    let timeoutId: ReturnType<typeof setTimeout>;
    // Queued bonus lines wait here until the current line finishes its
    // natural type/hold/delete cycle — never interrupts what's mid-typing.
    const queuedBonusLines: string[] = [];
    let bonusClickCount = 0;

    function typeLine(line: string, charIndex: number) {
      textEl!.textContent = line.slice(0, charIndex);
      if (charIndex < line.length) {
        timeoutId = setTimeout(() => typeLine(line, charIndex + 1), TYPE_MS);
      } else {
        timeoutId = setTimeout(() => deleteLine(line, line.length), HOLD_MS);
      }
    }

    function advanceToNextLine() {
      const bonusLine = queuedBonusLines.shift();
      if (bonusLine !== undefined) {
        timeoutId = setTimeout(() => typeLine(bonusLine, 0), TYPE_MS);
        return;
      }
      lineIndex = (lineIndex + 1) % lines.length;
      timeoutId = setTimeout(() => typeLine(lines[lineIndex], 0), TYPE_MS);
    }

    function deleteLine(line: string, charIndex: number) {
      textEl!.textContent = line.slice(0, charIndex);
      if (charIndex > 0) {
        timeoutId = setTimeout(() => deleteLine(line, charIndex - 1), DELETE_MS);
      } else {
        advanceToNextLine();
      }
    }

    typeLine(lines[0], 0);

    document.addEventListener("visibilitychange", () => {
      clearTimeout(timeoutId);
      if (!document.hidden) {
        typeLine(lines[lineIndex], 0);
      }
    });

    // First two accepted activations queue a bonus line and give a subtle
    // acknowledgement pulse; third and later activations are silently
    // ignored per spec.
    root.addEventListener("click", () => {
      bonusClickCount += 1;
      if (bonusClickCount > 2) return;
      const bonusLine = bonusLines[bonusClickCount - 1];
      if (bonusLine) queuedBonusLines.push(bonusLine);
      root.classList.remove("typewriter--pulse");
      void root.offsetWidth;
      root.classList.add("typewriter--pulse");
    });
  } else if (cursorEl && prefersReducedMotion) {
    cursorEl.style.display = "none";
  }
</script>
