---
import { Icon } from "astro-icon/components";
import type { ExperienceEntry } from "../data/experience";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContactDrawer from "./ContactDrawer.astro";
import ContactTrigger from "./ContactTrigger.astro";
import ExperienceDetailContent from "./ExperienceDetailContent.astro";
import SpineNav, { type SpineItem } from "./SpineNav.astro";
import { dateLabel, monogram, orgName } from "../utils/experienceDisplay";

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
const defaultSlug = "gold-ocean";

const spineItems: SpineItem[] = entries.map((entry) => ({
  slug: entry.slug,
  logoSrc: entry.logo,
  monogram: entry.logo ? undefined : monogram(entry),
  line1: entry.title,
  line2: entry.kind === "work" ? orgName(entry) : undefined,
  line3: dateLabel(entry),
}));
---
<section class="experience-section page-shell" aria-labelledby="experience-heading">
  <div class="page-utility-row">
    <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Experience" }]} />
    <ContactTrigger />
  </div>
  <div class="page-title-group">
    <Icon name="lucide:briefcase" aria-hidden="true" />
    <h2 id="experience-heading" class="page-title" tabindex="-1">Experience</h2>
  </div>

  <!-- Groups both layout variants as one unit, distinct from the
       breadcrumb/title row above — on tall/large screens (see the
       "spacious" query below) this whole group centers in the leftover
       vertical space while the breadcrumb/header stays pinned at the top. -->
  <div class="experience-content">
    <div class="experience-layout">
      <SpineNav items={spineItems} defaultSlug={defaultSlug} dataAttr="data-spine-role" ariaLabel="Career timeline" />

      <div class="experience-detail">
        {entries.map((entry) => (
          <article
            class="experience-detail__panel"
            id={`experience-detail-${entry.slug}`}
            data-role-detail={entry.slug}
            hidden={entry.slug !== defaultSlug}
          >
            <span class="eyebrow">{entry.kind === "work" ? "Work" : "Education"}</span>
            <h3 id={`experience-detail-heading-${entry.slug}`} tabindex="-1">
              {entry.title} {entry.company ? `· ${entry.company}` : ""}
            </h3>
            <p class="experience-detail__dates">
              {dateLabel(entry)}{entry.location ? ` · ${entry.location}` : ""}
            </p>
            <ExperienceDetailContent entry={entry} />
          </article>
        ))}
      </div>
    </div>

    <div class="experience-accordion">
      {entries.map((entry) => (
        <details
          class="experience-accordion__item"
          data-accordion-role={entry.slug}
        >
          <summary>
            {entry.logo ? (
              <img class="experience-spine__logo" src={entry.logo} alt="" width="28" height="28" loading="lazy" />
            ) : (
              <span class="experience-spine__logo" aria-hidden="true">{monogram(entry)}</span>
            )}
            <span class="experience-spine__text">
              <span class="experience-spine__role">{entry.title}</span>
              {entry.kind === "work" && <span class="experience-spine__org">{orgName(entry)}</span>}
              <span class="experience-spine__dates">{dateLabel(entry)}</span>
            </span>
            <Icon name="lucide:chevron-down" aria-hidden="true" class="experience-accordion__chevron" />
          </summary>
          <div class="experience-accordion__panel" data-accordion-panel>
            <div class="experience-accordion__panel-inner">
              <ExperienceDetailContent entry={entry} />
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>

  <ContactDrawer currentPage="experience" />
</section>

<style>
  /* 100% of <main>, not 100svh of the viewport — <main> is already sized to
     leave room for the footer (BaseLayout.astro's flex-column body), so
     matching it means short pages fill up to the footer, not past it. */
  .experience-section {
    min-height: 100%;
  }

  /* Matches the small icon+heading treatment Projects' bento title tile
     uses (same size/color/gap) so the two pages read as one system. The
     row carries the spacing .page-title normally holds on its own, since
     the title is now a flex item sharing the row with the icon. */
  .page-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .page-title-group .page-title {
    margin-bottom: 0;
  }

  .page-title-group :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .experience-layout {
    display: none;
    gap: var(--space-6);
  }

  /* "Spacious" viewport mode (see global.css) — breadcrumb/title row stays
     pinned at the top, the layout/accordion group below (whichever is
     visible at this width) centers in the leftover vertical space. Unlike
     Projects, Experience only has one shared header regardless of width,
     so this needs no width-bounded split. */
  @media (min-width: 760px) and (min-height: 850px) {
    .experience-section {
      display: flex;
      flex-direction: column;
    }

    .experience-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  /* minmax(180px, 250px) lets the spine shrink down to a still-legible 180px
     before the (much larger) detail column gets cramped, instead of holding
     a fixed/min width that ate space disproportionately at medium viewport
     widths and forced the detail panel's content to wrap taller than needed.
     250px (not 240px) gives the logo+text rows enough room at their new
     space-3 gap to stop wrapping on a couple of entries. */
  @media (min-width: 900px) {
    .experience-layout {
      display: grid;
      grid-template-columns: minmax(180px, 250px) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* Widens the spine column's cap to match the "spacious" font-size bump
     (see global.css) — that bump grows the spine row text (rem-based) but
     not this fixed-px column, so the longest title (Senior Software
     Engineer) started wrapping onto an extra line it didn't need at 100%
     scale. 280px gives it the room back; there's plenty of width to spare
     at these sizes anyway. */
  @media (min-width: 900px) and (min-height: 850px) {
    .experience-layout {
      grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    }
  }

  /* .experience-spine__logo/__text/__role/__org/__dates below are still
     used by the mobile accordion's <summary> (its own markup, further
     down) — the desktop nav itself now lives in SpineNav.astro, which has
     its own equivalent (spine__logo etc.) styles, but the accordion's
     markup wasn't touched, so its classes and their styles stay here. */
  .experience-spine__logo {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
    /* Real logo files vary — some are transparent, some carry their own
       flat/grey background baked in — so a consistent frame around every
       tile reads as "this is an icon container" regardless of what's
       inside, instead of individual logos looking like stray boxes against
       the card. */
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    /* object-fit only matters for the <img> variant (real logo) — harmless
       no-op on the monogram <span> fallback. */
    object-fit: cover;
  }

  /* Fixed light backing (not the theme-reactive surface-alt above) — some
     logo marks are dark line-art on a transparent PNG with no color info of
     their own, so they'd read fine in light mode but nearly vanish against
     the dark-mode tile. A permanent light plate keeps every logo image
     legible in both themes regardless of the mark's own color. */
  img.experience-spine__logo {
    background: #EEF6F8;
  }

  .experience-spine__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Position/title is the primary line; company/institution is intentionally
     one step down in weight so the two-line (education) / three-line (work)
     hierarchy reads clearly instead of both lines competing for attention. */
  .experience-spine__role {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .experience-spine__org {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .experience-spine__dates {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .experience-detail {
    min-width: 0;
  }

  .experience-detail__panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-detail__panel h3 {
    margin-top: var(--space-1);
  }

  .experience-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-accordion__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    cursor: pointer;
  }

  /* Hover feedback lives on the <details> element itself (the whole card),
     matching how spine items and project cards show hover on their own
     full extent. Scoped to devices with real, precise hover — touch/iPadOS
     can leave :hover "stuck" on an element after a tap until some later,
     unrelated touch clears it (a long-documented WebKit quirk), which on
     this list showed up as a second, already-closed card looking
     highlighted alongside whichever one was actually just interacted with. */
  @media (hover: hover) and (pointer: fine) {
    .experience-accordion__item:hover {
      border-color: var(--color-accent-teal);
      background: var(--color-surface-alt);
    }
  }

  .experience-accordion__item:focus-within {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .experience-accordion__item summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
  }

  /* The card's own :focus-within border/background above is the focus
     indicator for this control — suppress the global :focus-visible ring
     on the summary itself so tabbing here doesn't show two overlapping
     "you are here" signals (the card border change and an inner ring). */
  .experience-accordion__item summary:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .experience-accordion__item summary::-webkit-details-marker {
    display: none;
  }

  /* Pushed to the far right of the header; rotation is toggled via the
     is-expanded class (kept in sync with the panel's own open/close
     animation in script, not the native `open` attribute — see
     openAccordionItem/closeAccordionItem) so it turns in lockstep with the
     panel instead of snapping at the end of the close animation. */
  .experience-accordion__chevron {
    margin-left: auto;
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-text-muted);
    transition: transform 240ms ease-out;
  }

  .experience-accordion__item.is-expanded .experience-accordion__chevron {
    transform: rotate(180deg);
  }

  /* grid-template-rows 1fr -> 0fr is the standard CSS-only technique for
     animating to/from "auto" height without JS measuring scrollHeight.
     Default is 1fr (fully shown) so a no-JS/JS-failure fallback renders
     every panel's content immediately and correctly — the .is-collapsing
     modifier that drives the actual accordion look is only ever added by
     script (see this component's <script> below), never present in the
     server-rendered HTML. */
  .experience-accordion__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 240ms ease-out;
  }

  .experience-accordion__panel.is-collapsing {
    grid-template-rows: 0fr;
  }

  /* Suppresses the transition for one synchronous style write (see
     openAccordionItem in the script below). Without this, a panel's very
     first open — going straight from "not yet rendered" to its full auto
     height the instant <details> reveals it — has a real committed
     expanded value already in place, so forcing is-collapsing on right
     after that to fake a 0fr starting point gets caught by the transition
     rule and animates on its own, which then gets cut short a couple
     frames later when the class is removed again. Disabling the transition
     for that one write makes the reset instant and silent, exactly like a
     panel that's already sitting at 0fr from a prior close. */
  .experience-accordion__panel.no-transition {
    transition: none;
  }

  .experience-accordion__panel-inner {
    overflow: hidden;
    min-height: 0;
    padding-top: var(--space-3);
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  .experience-accordion__panel.is-collapsing .experience-accordion__panel-inner {
    opacity: 0;
  }

  @media (min-width: 900px) {
    .experience-accordion {
      display: none;
    }
  }
</style>

<script>
  import { getQueryParam, setSectionState } from "../utils/urlState";
  import { moveFocusTo } from "../utils/focus";
  import { playEnterAnimation } from "../utils/motion";

  // On a reload, the browser tries to restore whatever scroll position the
  // page had before — and can do so after our own deep-link scroll runs,
  // yanking it back. A delay to try to win that race would be a guess;
  // this removes the race instead, since we're already deriving scroll
  // position from the URL ourselves.
  if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
  }

  const spineItems = document.querySelectorAll<HTMLButtonElement>("[data-spine-role]");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-role-detail]");
  const accordionItems = document.querySelectorAll<HTMLDetailsElement>("[data-accordion-role]");
  const defaultSlug = "gold-ocean";

  // Animate <details> open/close instead of relying on the browser's
  // instant native toggle. Opening: force the panel to its collapsed (0fr)
  // state on the same frame `open` becomes true, then release it on the
  // next frame so the transition has something to animate from. Closing:
  // <details> hides non-summary content the instant `open` goes false, so
  // we hold `open` true, animate the panel to collapsed, and only flip
  // `open` off once the transition actually finishes.
  function openAccordionItem(item: HTMLDetailsElement) {
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    item.open = true;
    item.classList.add("is-expanded");
    if (!panel) return;
    // no-transition makes this reset-to-collapsed step instant instead of
    // itself animating (see the class's own comment above, in <style>) —
    // required so a panel's very first open collapses to 0fr silently, the
    // same way a panel that's already sitting at 0fr from a prior close
    // does, before the real open transition below runs.
    panel.classList.add("no-transition");
    panel.classList.add("is-collapsing");
    void panel.offsetHeight;
    panel.classList.remove("no-transition");
    requestAnimationFrame(() => {
      panel.classList.remove("is-collapsing");
    });
  }

  function closeAccordionItem(item: HTMLDetailsElement) {
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    // Removed immediately (not deferred to transitionend like `open`) so the
    // chevron rotates back down in sync with the collapse animation starting,
    // rather than waiting for the whole panel to finish closing.
    item.classList.remove("is-expanded");
    if (!panel) {
      item.open = false;
      return;
    }
    panel.classList.add("is-collapsing");
    const onEnd = (event: TransitionEvent) => {
      if (event.propertyName !== "grid-template-rows") return;
      panel.removeEventListener("transitionend", onEnd);
      // Only close if this element is still the one collapsing — guards
      // against a stale listener firing after a rapid re-open reversed it.
      if (panel.classList.contains("is-collapsing")) {
        item.open = false;
        // <details> stops rendering this content the instant open is false,
        // so this has no visual effect — it just leaves the panel in a
        // clean (non-collapsing) state for the next time it's opened.
        panel.classList.remove("is-collapsing");
      }
    };
    panel.addEventListener("transitionend", onEnd);
  }

  // Scrolls a just-opened accordion item into view, but only if its header
  // genuinely isn't visible — not unconditionally on every open, which
  // would yank the page down even when the item was already fully on
  // screen. Waits for the open transition to finish first, since the
  // item's final position/height isn't settled until then.
  // Checks the summary specifically (not just the item's top edge) and
  // requires it to be FULLY on screen with a little breathing room at the
  // bottom — not merely fitting exactly flush against the viewport's lower
  // edge, which is technically "visible" but reads as crammed/easy to miss.
  function scrollAccordionItemIntoViewIfNeeded(item: HTMLDetailsElement) {
    const COMFORTABLE_BOTTOM_MARGIN = 24;
    const summary = item.querySelector<HTMLElement>("summary");
    const rect = (summary ?? item).getBoundingClientRect();
    const alreadyVisible = rect.top >= 0 && rect.bottom <= window.innerHeight - COMFORTABLE_BOTTOM_MARGIN;
    if (!alreadyVisible) {
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      item.scrollIntoView({ block: "start", behavior: prefersReducedMotion ? "auto" : "smooth" });
    }
  }

  // Same check as above, but waits for the item's open transition to finish
  // first — its final height (and so its neighbors' positions) isn't
  // settled until then.
  function scrollAccordionItemIntoViewAfterOpen(item: HTMLDetailsElement) {
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    if (!panel) return;
    const onOpenTransitionEnd = (event: TransitionEvent) => {
      if (event.propertyName !== "grid-template-rows") return;
      panel.removeEventListener("transitionend", onOpenTransitionEnd);
      scrollAccordionItemIntoViewIfNeeded(item);
    };
    panel.addEventListener("transitionend", onOpenTransitionEnd);
  }

  // Safari doesn't reliably honor focus()'s preventScroll option, so it can
  // still jump the page on its own even when we ask it not to — undoing
  // that afterward (rather than trusting preventScroll alone) keeps this
  // correct regardless of whether the browser actually supports it.
  function focusWithoutScrolling(el: HTMLElement) {
    const { scrollX, scrollY } = window;
    el.focus({ preventScroll: true });
    if (window.scrollX !== scrollX || window.scrollY !== scrollY) {
      window.scrollTo(scrollX, scrollY);
    }
  }

  function selectRole(slug: string, focusPanel = false) {
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.roleDetail);
    const target = validSlugs.includes(slug) ? slug : defaultSlug;

    spineItems.forEach((item) => {
      item.setAttribute("aria-pressed", String(item.dataset.spineRole === target));
    });
    detailPanels.forEach((panel) => {
      const isTarget = panel.dataset.roleDetail === target;
      panel.hidden = !isTarget;
      // Only animate on a genuine user-initiated spine click (focusPanel),
      // not on initial page load/URL sync — the static HTML should just
      // appear, not fade in, on first paint.
      if (isTarget && focusPanel) playEnterAnimation(panel);
    });
    if (focusPanel) moveFocusTo(`#experience-detail-heading-${target}`);
  }

  // Brings the mobile accordion's open/closed state in line with the URL's
  // role param. Only relevant for a deep link — with no role param, every
  // item stays closed (the server-rendered default), same as landing on
  // any other fresh accordion.
  function syncAccordionToTarget(target: string, isDeepLink: boolean) {
    if (!isDeepLink) return;
    accordionItems.forEach((item) => {
      const shouldBeOpen = item.dataset.accordionRole === target;
      if (item.open === shouldBeOpen) return;
      const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
      item.open = shouldBeOpen;
      item.classList.toggle("is-expanded", shouldBeOpen);
      if (panel) {
        panel.classList.add("no-transition");
        panel.classList.toggle("is-collapsing", !shouldBeOpen);
        void panel.offsetHeight;
        panel.classList.remove("no-transition");
      }
      if (shouldBeOpen) {
        // Unconditional, unlike the live-click path — a deep link is an
        // explicit "take me here", like navigating to a URL fragment, so it
        // should always reposition the page, not just when the item
        // happens not to already be in view.
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        item.scrollIntoView({ block: "start", behavior: prefersReducedMotion ? "auto" : "smooth" });
        const summary = item.querySelector<HTMLElement>("summary");
        if (summary) focusWithoutScrolling(summary);
      }
    });
  }

  function syncFromUrl() {
    const slug = getQueryParam("role");
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.roleDetail);
    const isDeepLink = Boolean(slug && validSlugs.includes(slug));
    const target = isDeepLink ? slug! : defaultSlug;
    selectRole(target);
    syncAccordionToTarget(target, isDeepLink);
  }

  spineItems.forEach((item) => {
    item.addEventListener("click", () => {
      const slug = item.dataset.spineRole;
      if (!slug) return;
      selectRole(slug, true);
      setSectionState({ key: "role", value: slug });
    });
  });

  accordionItems.forEach((item) => {
    const summary = item.querySelector<HTMLElement>("summary");

    // Browsers focus a clickable element on mousedown — before click ever
    // fires — and can scroll the page as part of that focus change. That
    // scroll targets wherever the newly-revealed panel content ends up,
    // not the card itself, so the header (and the border/chevron that
    // show it's expanded) can end up scrolled off above the viewport.
    // Suppressing the native focus transfer here stops that scroll before
    // it starts; the click handler below re-establishes real focus itself
    // (without scrolling) so the card's focus/hover highlight still shows.
    // Keyboard activation (Tab, then Enter/Space) never fires mousedown,
    // so this has no effect on keyboard users.
    summary?.addEventListener("mousedown", (event) => {
      event.preventDefault();
    });

    // Intercept the click rather than listening for "toggle" — native
    // <details> toggles (and hides its content) the instant the summary is
    // clicked, before any JS runs, which is exactly the "jumps open, then
    // the content animates in afterward" problem. preventDefault() here
    // hands control to openAccordionItem/closeAccordionItem so the panel's
    // height animates instead of snapping. If JS never loads, this listener
    // never attaches and the native click-to-toggle still works, just
    // without the animation.
    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      const slug = item.dataset.accordionRole;
      if (!slug) return;
      if (item.open) {
        // Sections behave independently — closing one only affects itself,
        // any other expanded sections stay open.
        closeAccordionItem(item);
        return;
      }
      // Opening this item does not close any other open accordion item —
      // multiple Experience entries can stay expanded simultaneously.
      // selectRole() still keeps the desktop spine/detail panel (present in
      // the DOM at once, just hidden by CSS at this breakpoint) in sync.
      openAccordionItem(item);
      // Re-establish focus ourselves — the mousedown listener above
      // suppressed the browser's own focus transfer, so without this the
      // card would lose its focus/hover highlight after a click. This
      // targets the summary, not the card itself (see the matching comment
      // in syncAccordionToTarget for why: giving <details> a tabindex to
      // make it focusable breaks native Tab access to its own summary).
      // The highlight still reads as "this whole card" either way, since
      // it's driven by :focus-within on the card, not by which exact
      // descendant holds focus.
      if (summary) focusWithoutScrolling(summary);
      scrollAccordionItemIntoViewAfterOpen(item);
      selectRole(slug);
      setSectionState({ key: "role", value: slug });
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
