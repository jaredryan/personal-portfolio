---
import type { ExperienceEntry } from "../data/experience";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContactDrawer from "./ContactDrawer.astro";
import ContactTrigger from "./ContactTrigger.astro";
import ExperienceDetailContent from "./ExperienceDetailContent.astro";
import SpineNav, { type SpineItem } from "./SpineNav.astro";
import { dateLabel, monogram, orgName } from "../utils/experienceDisplay";

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
const defaultSlug = "gold-ocean";

const spineItems: SpineItem[] = entries.map((entry) => ({
  slug: entry.slug,
  logoSrc: entry.logo,
  monogram: entry.logo ? undefined : monogram(entry),
  line1: entry.title,
  line2: entry.kind === "work" ? orgName(entry) : undefined,
  line3: dateLabel(entry),
}));
---
<section class="experience-section page-shell" aria-labelledby="experience-heading">
  <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Experience" }]} />
  <div class="page-header-row">
    <h2 id="experience-heading" class="page-title" tabindex="-1">Experience</h2>
    <ContactTrigger />
  </div>

  <div class="experience-layout">
    <SpineNav items={spineItems} defaultSlug={defaultSlug} dataAttr="data-spine-role" ariaLabel="Career timeline" />

    <div class="experience-detail">
      {entries.map((entry) => (
        <article
          class="experience-detail__panel"
          id={`experience-detail-${entry.slug}`}
          data-role-detail={entry.slug}
          hidden={entry.slug !== defaultSlug}
        >
          <span class="eyebrow">{entry.kind === "work" ? "Work" : "Education"}</span>
          <h3 id={`experience-detail-heading-${entry.slug}`} tabindex="-1">
            {entry.title} {entry.company ? `· ${entry.company}` : ""}
          </h3>
          <p class="experience-detail__dates">
            {dateLabel(entry)}{entry.location ? ` · ${entry.location}` : ""}
          </p>
          <ExperienceDetailContent entry={entry} />
        </article>
      ))}
    </div>
  </div>

  <div class="experience-accordion">
    {entries.map((entry) => (
      <details class="experience-accordion__item" data-accordion-role={entry.slug} open={entry.slug === defaultSlug}>
        <summary>
          {entry.logo ? (
            <img class="experience-spine__logo" src={entry.logo} alt="" width="28" height="28" loading="lazy" />
          ) : (
            <span class="experience-spine__logo" aria-hidden="true">{monogram(entry)}</span>
          )}
          <span class="experience-spine__text">
            <span class="experience-spine__role">{entry.title}</span>
            {entry.kind === "work" && <span class="experience-spine__org">{orgName(entry)}</span>}
            <span class="experience-spine__dates">{dateLabel(entry)}</span>
          </span>
        </summary>
        <div class="experience-accordion__panel" data-accordion-panel>
          <div class="experience-accordion__panel-inner">
            <ExperienceDetailContent entry={entry} />
          </div>
        </div>
      </details>
    ))}
  </div>

  <ContactDrawer currentPage="experience" />
</section>

<style>
  .experience-section {
    min-height: 100svh;
  }

  /* Contact is a secondary utility action, far-right on the same row as
     the page title — not crowding the breadcrumb row above it. The row
     itself carries the spacing .page-title normally holds on its own,
     since the title is now a flex item sharing the row with the button. */
  .page-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .page-header-row .page-title {
    margin-bottom: 0;
  }

  .experience-layout {
    display: none;
    gap: var(--space-6);
  }

  /* minmax(180px, 250px) lets the spine shrink down to a still-legible 180px
     before the (much larger) detail column gets cramped, instead of holding
     a fixed/min width that ate space disproportionately at medium viewport
     widths and forced the detail panel's content to wrap taller than needed.
     250px (not 240px) gives the logo+text rows enough room at their new
     space-3 gap to stop wrapping on a couple of entries. */
  @media (min-width: 900px) {
    .experience-layout {
      display: grid;
      grid-template-columns: minmax(180px, 250px) minmax(0, 1fr);
      align-items: start;
    }
  }

  /* .experience-spine__logo/__text/__role/__org/__dates below are still
     used by the mobile accordion's <summary> (its own markup, further
     down) — the desktop nav itself now lives in SpineNav.astro, which has
     its own equivalent (spine__logo etc.) styles, but the accordion's
     markup wasn't touched, so its classes and their styles stay here. */
  .experience-spine__logo {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
    /* Real logo files vary — some are transparent, some carry their own
       flat/grey background baked in — so a consistent frame around every
       tile reads as "this is an icon container" regardless of what's
       inside, instead of individual logos looking like stray boxes against
       the card. */
    border: 1px solid var(--color-border);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    /* object-fit only matters for the <img> variant (real logo) — harmless
       no-op on the monogram <span> fallback. */
    object-fit: cover;
  }

  /* Fixed light backing (not the theme-reactive surface-alt above) — some
     logo marks are dark line-art on a transparent PNG with no color info of
     their own, so they'd read fine in light mode but nearly vanish against
     the dark-mode tile. A permanent light plate keeps every logo image
     legible in both themes regardless of the mark's own color. */
  img.experience-spine__logo {
    background: #EEF6F8;
  }

  .experience-spine__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Position/title is the primary line; company/institution is intentionally
     one step down in weight so the two-line (education) / three-line (work)
     hierarchy reads clearly instead of both lines competing for attention. */
  .experience-spine__role {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .experience-spine__org {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .experience-spine__dates {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .experience-detail {
    min-width: 0;
  }

  .experience-detail__panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-detail__panel h3 {
    margin-top: var(--space-1);
  }

  .experience-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-accordion__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    cursor: pointer;
  }

  /* Hover feedback lives on the <details> element itself (the whole card),
     matching how spine items and project cards show hover on their own
     full extent. */
  .experience-accordion__item:hover,
  .experience-accordion__item:focus-within {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .experience-accordion__item summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    list-style: none;
  }

  /* The card's own :focus-within border/background above is the focus
     indicator for this control — suppress the global :focus-visible ring
     on the summary itself so tabbing here doesn't show two overlapping
     "you are here" signals (the card border change and an inner ring). */
  .experience-accordion__item summary:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .experience-accordion__item summary::-webkit-details-marker {
    display: none;
  }

  /* grid-template-rows 1fr -> 0fr is the standard CSS-only technique for
     animating to/from "auto" height without JS measuring scrollHeight.
     Default is 1fr (fully shown) so a no-JS/JS-failure fallback renders
     every panel's content immediately and correctly — the .is-collapsing
     modifier that drives the actual accordion look is only ever added by
     script (see this component's <script> below), never present in the
     server-rendered HTML. */
  .experience-accordion__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 240ms ease-out;
  }

  .experience-accordion__panel.is-collapsing {
    grid-template-rows: 0fr;
  }

  .experience-accordion__panel-inner {
    overflow: hidden;
    min-height: 0;
    padding-top: var(--space-3);
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  .experience-accordion__panel.is-collapsing .experience-accordion__panel-inner {
    opacity: 0;
  }

  @media (min-width: 900px) {
    .experience-accordion {
      display: none;
    }
  }
</style>

<script>
  import { getQueryParam, setSectionState } from "../utils/urlState";
  import { moveFocusTo } from "../utils/focus";
  import { playEnterAnimation } from "../utils/motion";

  const spineItems = document.querySelectorAll<HTMLButtonElement>("[data-spine-role]");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-role-detail]");
  const accordionItems = document.querySelectorAll<HTMLDetailsElement>("[data-accordion-role]");
  const defaultSlug = "gold-ocean";

  // Animate <details> open/close instead of relying on the browser's
  // instant native toggle. Opening: force the panel to its collapsed (0fr)
  // state on the same frame `open` becomes true, then release it on the
  // next frame so the transition has something to animate from. Closing:
  // <details> hides non-summary content the instant `open` goes false, so
  // we hold `open` true, animate the panel to collapsed, and only flip
  // `open` off once the transition actually finishes.
  function openAccordionItem(item: HTMLDetailsElement) {
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    item.open = true;
    if (!panel) return;
    panel.classList.add("is-collapsing");
    void panel.offsetHeight;
    requestAnimationFrame(() => {
      panel.classList.remove("is-collapsing");
    });
  }

  function closeAccordionItem(item: HTMLDetailsElement) {
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    if (!panel) {
      item.open = false;
      return;
    }
    panel.classList.add("is-collapsing");
    const onEnd = (event: TransitionEvent) => {
      if (event.propertyName !== "grid-template-rows") return;
      panel.removeEventListener("transitionend", onEnd);
      // Only close if this element is still the one collapsing — guards
      // against a stale listener firing after a rapid re-open reversed it.
      if (panel.classList.contains("is-collapsing")) {
        item.open = false;
        // <details> stops rendering this content the instant open is false,
        // so this has no visual effect — it just leaves the panel in a
        // clean (non-collapsing) state for the next time it's opened.
        panel.classList.remove("is-collapsing");
      }
    };
    panel.addEventListener("transitionend", onEnd);
  }

  function selectRole(slug: string, focusPanel = false) {
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.roleDetail);
    const target = validSlugs.includes(slug) ? slug : defaultSlug;

    spineItems.forEach((item) => {
      item.setAttribute("aria-pressed", String(item.dataset.spineRole === target));
    });
    detailPanels.forEach((panel) => {
      const isTarget = panel.dataset.roleDetail === target;
      panel.hidden = !isTarget;
      // Only animate on a genuine user-initiated spine click (focusPanel),
      // not on initial page load/URL sync — the static HTML should just
      // appear, not fade in, on first paint.
      if (isTarget && focusPanel) playEnterAnimation(panel);
    });
    // Syncing every item (not just the target) is what keeps the mobile
    // accordion single-selection: any other item that was previously open
    // gets closed here, so at most one role is ever expanded at a time —
    // matching the desktop career-spine model where exactly one is selected.
    // Only items whose state is actually changing get animated; items
    // already in the right state (e.g. the default on initial load) are
    // left untouched so nothing animates on first paint.
    accordionItems.forEach((item) => {
      const isTarget = item.dataset.accordionRole === target;
      if (isTarget && !item.open) openAccordionItem(item);
      else if (!isTarget && item.open) closeAccordionItem(item);
    });

    if (focusPanel) moveFocusTo(`#experience-detail-heading-${target}`);
  }

  function syncFromUrl() {
    const slug = getQueryParam("role");
    selectRole(slug ?? defaultSlug);
  }

  spineItems.forEach((item) => {
    item.addEventListener("click", () => {
      const slug = item.dataset.spineRole;
      if (!slug) return;
      selectRole(slug, true);
      setSectionState({ key: "role", value: slug });
    });
  });

  accordionItems.forEach((item) => {
    const summary = item.querySelector("summary");
    // Intercept the click rather than listening for "toggle" — native
    // <details> toggles (and hides its content) the instant the summary is
    // clicked, before any JS runs, which is exactly the "jumps open, then
    // the content animates in afterward" problem. preventDefault() here
    // hands control to openAccordionItem/closeAccordionItem so the panel's
    // height animates instead of snapping. If JS never loads, this listener
    // never attaches and the native click-to-toggle still works, just
    // without the animation.
    summary?.addEventListener("click", (event) => {
      event.preventDefault();
      const slug = item.dataset.accordionRole;
      if (!slug) return;
      if (item.open) {
        // Matches the prior native behavior: clicking the open item closes
        // it, leaving nothing expanded.
        closeAccordionItem(item);
        return;
      }
      // selectRole() closes every other accordion item so only one stays
      // open, and keeps the desktop spine/detail panel (both present in the
      // DOM at once, just hidden by CSS at this breakpoint) in sync too.
      selectRole(slug);
      setSectionState({ key: "role", value: slug });
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
