---
import type { ExperienceEntry } from "../data/experience";
import Breadcrumbs from "./Breadcrumbs.astro";
import ExperienceDetailContent from "./ExperienceDetailContent.astro";
import { dateLabel, monogram, orgName } from "../utils/experienceDisplay";

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
const defaultSlug = "gold-ocean";
---
<section class="experience-section page-shell" aria-labelledby="experience-heading">
  <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Experience" }]} />
  <h2 id="experience-heading" class="page-title" tabindex="-1">Experience</h2>

  <div class="experience-layout">
    <nav class="experience-spine" aria-label="Career timeline">
      {entries.map((entry) => (
        <button
          type="button"
          class="experience-spine__item"
          data-spine-role={entry.slug}
          aria-pressed={entry.slug === defaultSlug ? "true" : "false"}
        >
          <span class="experience-spine__logo" aria-hidden="true">{monogram(entry)}</span>
          <span class="experience-spine__text">
            <span class="experience-spine__role">{entry.title}</span>
            {entry.kind === "work" && <span class="experience-spine__org">{orgName(entry)}</span>}
            <span class="experience-spine__dates">{dateLabel(entry)}</span>
          </span>
        </button>
      ))}
    </nav>

    <div class="experience-detail">
      {entries.map((entry) => (
        <article
          class="experience-detail__panel"
          id={`experience-detail-${entry.slug}`}
          data-role-detail={entry.slug}
          hidden={entry.slug !== defaultSlug}
        >
          <span class="eyebrow">{entry.kind === "work" ? "Work" : "Education"}</span>
          <h3 id={`experience-detail-heading-${entry.slug}`} tabindex="-1">
            {entry.title} {entry.company ? `· ${entry.company}` : ""}
          </h3>
          <p class="experience-detail__dates">
            {dateLabel(entry)}{entry.location ? ` · ${entry.location}` : ""}
          </p>
          <ExperienceDetailContent entry={entry} />
        </article>
      ))}
    </div>
  </div>

  <div class="experience-accordion">
    {entries.map((entry) => (
      <details class="experience-accordion__item" data-accordion-role={entry.slug} open={entry.slug === defaultSlug}>
        <summary>
          <span class="experience-spine__logo" aria-hidden="true">{monogram(entry)}</span>
          <span class="experience-spine__text">
            <span class="experience-spine__role">{entry.title}</span>
            {entry.kind === "work" && <span class="experience-spine__org">{orgName(entry)}</span>}
            <span class="experience-spine__dates">{dateLabel(entry)}</span>
          </span>
        </summary>
        <ExperienceDetailContent entry={entry} />
      </details>
    ))}
  </div>
</section>

<style>
  .experience-section {
    min-height: 100svh;
  }

  .experience-layout {
    display: none;
    gap: var(--space-6);
  }

  /* minmax(180px, 240px) lets the spine shrink down to a still-legible 180px
     before the (much larger) detail column gets cramped, instead of holding
     a fixed/min width that ate space disproportionately at medium viewport
     widths and forced the detail panel's content to wrap taller than needed. */
  @media (min-width: 900px) {
    .experience-layout {
      display: grid;
      grid-template-columns: minmax(180px, 240px) minmax(0, 1fr);
      align-items: start;
    }
  }

  .experience-spine {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .experience-spine__item {
    position: relative;
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .experience-spine__item:hover,
  .experience-spine__item:focus-visible {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .experience-spine__item[aria-pressed="true"] {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .experience-spine__item[aria-pressed="true"]::before {
    content: "";
    position: absolute;
    inset-block: var(--space-2);
    left: 0;
    width: 3px;
    border-radius: 999px;
    background: var(--color-accent-coral);
  }

  .experience-spine__logo {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-alt);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .experience-spine__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Position/title is the primary line; company/institution is intentionally
     one step down in weight so the two-line (education) / three-line (work)
     hierarchy reads clearly instead of both lines competing for attention. */
  .experience-spine__role {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .experience-spine__org {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .experience-spine__dates {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .experience-detail {
    min-width: 0;
  }

  .experience-detail__panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-detail__panel h3 {
    margin-top: var(--space-1);
  }

  .experience-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .experience-accordion__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    cursor: pointer;
  }

  /* Hover feedback lives on the <details> element itself (the whole card),
     matching how spine items and project cards show hover on their own
     full extent. */
  .experience-accordion__item:hover,
  .experience-accordion__item:focus-within {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .experience-accordion__item summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  /* The card's own :focus-within border/background above is the focus
     indicator for this control — suppress the global :focus-visible ring
     on the summary itself so tabbing here doesn't show two overlapping
     "you are here" signals (the card border change and an inner ring). */
  .experience-accordion__item summary:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .experience-accordion__item summary::-webkit-details-marker {
    display: none;
  }

  .experience-accordion__item[open] summary {
    margin-bottom: var(--space-3);
  }

  @media (min-width: 900px) {
    .experience-accordion {
      display: none;
    }
  }
</style>

<script>
  import { getQueryParam, setSectionState } from "../utils/urlState";
  import { moveFocusTo } from "../utils/focus";
  import { playEnterAnimation } from "../utils/motion";

  const spineItems = document.querySelectorAll<HTMLButtonElement>("[data-spine-role]");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-role-detail]");
  const accordionItems = document.querySelectorAll<HTMLDetailsElement>("[data-accordion-role]");
  const defaultSlug = "gold-ocean";

  function selectRole(slug: string, focusPanel = false) {
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.roleDetail);
    const target = validSlugs.includes(slug) ? slug : defaultSlug;

    spineItems.forEach((item) => {
      item.setAttribute("aria-pressed", String(item.dataset.spineRole === target));
    });
    detailPanels.forEach((panel) => {
      const isTarget = panel.dataset.roleDetail === target;
      panel.hidden = !isTarget;
      // Only animate on a genuine user-initiated spine click (focusPanel),
      // not on initial page load/URL sync — the static HTML should just
      // appear, not fade in, on first paint.
      if (isTarget && focusPanel) playEnterAnimation(panel);
    });
    // Setting .open on every item (not just the target) is what keeps the
    // mobile accordion single-selection: any other item that was previously
    // open gets closed here, so at most one role is ever expanded at a time —
    // matching the desktop career-spine model where exactly one is selected.
    accordionItems.forEach((item) => {
      item.open = item.dataset.accordionRole === target;
    });

    if (focusPanel) moveFocusTo(`#experience-detail-heading-${target}`);
  }

  function syncFromUrl() {
    const slug = getQueryParam("role");
    selectRole(slug ?? defaultSlug);
  }

  spineItems.forEach((item) => {
    item.addEventListener("click", () => {
      const slug = item.dataset.spineRole;
      if (!slug) return;
      selectRole(slug, true);
      setSectionState({ key: "role", value: slug });
    });
  });

  accordionItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      const slug = item.dataset.accordionRole;
      if (!slug) return;
      // selectRole() closes every other accordion item so only one stays
      // open, and keeps the desktop spine/detail panel (both present in the
      // DOM at once, just hidden by CSS at this breakpoint) in sync too.
      selectRole(slug);
      setSectionState({ key: "role", value: slug });
      // <details> opens instantly with no built-in transition; fading the
      // revealed content in (not attempting to animate the native
      // open/close itself) is the restrained, low-risk way to make it feel
      // less abrupt.
      playEnterAnimation(item.querySelector(".experience-detail-content"));
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
