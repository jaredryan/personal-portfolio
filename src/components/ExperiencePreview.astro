---
import { Icon } from "astro-icon/components";
import type { ExperienceEntry } from "../data/experience";
import { dateLabel, monogram, orgName, spineLine1 } from "../utils/experienceDisplay";
// Imported for their is:global CSS only — this component builds pill/chip
// markup by hand via document.createElement, but the styles live in these
// components' bundles and are only included on a page when the component
// module is actually imported (see PillList.astro's is:global comment).
import PillList from "./PillList.astro";
import MetricChips from "./MetricChips.astro";
void PillList;
void MetricChips;

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
---
<div class="experience-preview" id="experience-preview">
  <div class="experience-preview__header">
    <h2 class="eyebrow experience-preview__heading" data-preview-heading>Experience</h2>
    <button type="button" class="experience-preview__back" data-preview-back hidden>
      <Icon name="lucide:arrow-left" aria-hidden="true" />
      Experience
    </button>
    <a class="bento-expand-link" href="/experience" aria-label="Open full Experience page">
      <Icon name="lucide:arrow-up-right" aria-hidden="true" />
    </a>
  </div>

  <ul class="experience-preview__list" data-preview-list>
    {entries.map((entry) => (
      <li>
        <button
          type="button"
          class="experience-preview__row"
          data-preview-role={entry.slug}
          aria-label={entry.companyShort ? `${entry.title} · ${orgName(entry)}` : undefined}
        >
          {entry.logo ? (
            <img class="logo-tile" src={entry.logo} alt="" width="28" height="28" loading="lazy" />
          ) : (
            <span class="logo-tile" aria-hidden="true">{monogram(entry)}</span>
          )}
          <span class="experience-preview__row-text">
            <span class="experience-preview__row-line1">{spineLine1(entry)}</span>
            <span class="experience-preview__row-line2">{dateLabel(entry)}</span>
          </span>
        </button>
      </li>
    ))}
  </ul>

  <div class="experience-preview__detail" data-preview-detail hidden>
    <p class="experience-preview__detail-title" data-detail-title></p>
    <p class="experience-preview__detail-dates" data-detail-dates></p>
    <p class="experience-preview__detail-oneliner" data-detail-oneliner></p>
    <div class="experience-preview__detail-chips" data-detail-chips></div>
    <div class="experience-preview__detail-bullets-wrap" data-detail-bullets-wrap>
      <ul class="experience-preview__detail-bullets custom-bullets" data-detail-bullets></ul>
    </div>
    <div class="experience-preview__detail-pills" data-detail-pills></div>
    <a class="bento-seemore" data-detail-seemore href="/experience">See more →</a>
  </div>
</div>

<script type="application/json" id="experience-preview-data" set:html={JSON.stringify(
  entries.map((entry) => ({
    slug: entry.slug,
    kind: entry.kind,
    titleLine: spineLine1(entry),
    dates: dateLabel(entry),
    oneLiner: entry.oneLiner,
    metricChips: entry.metricChips,
    pills: entry.pills,
    bullets: entry.bullets,
  }))
)} />

<style>
  .experience-preview {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    /* Fixed height, not just a cap, on the single-column phone tier — it's
       what makes the overflow: hidden + flex: 1 truncation on
       .experience-preview__detail-bullets-wrap below actually kick in (that
       only has an effect once its ancestor chain has a definite height to
       fill) and keeps "See more" pinned to the same spot at the bottom of
       the card for every entry, long or short, instead of the whole card
       growing or shrinking as the user clicks between them. Deliberately
       shorter than the tablet/desktop value below — a full-width phone card
       reads as an oversized wall of empty space at that larger height. */
    height: 460px;
    overflow: hidden;
  }

  /* From the tablet tier up (this card side-by-side with Projects, roughly
     half width — matches BentoDashboard's own 700px tablet-tier floor)
     through the rest of the desktop-landscape tier below, more vertical
     room reads better than the phone default above. This value also stands
     as the desktop tier's pre-JS fallback: see the height-sync script in
     BentoDashboard.astro, which overrides it there with an inline px height
     computed from Hero + gap + Projects' actual rendered height. That JS
     step is necessary, not cosmetic — a plain height: 100% here is circular
     for a grid item spanning both rows (see that script's comment): with no
     definite height to resolve 100% against yet, the grid falls back to
     this card's own intrinsic content size to help size the very row it's
     supposed to fill, so a long detail view could inflate Experience taller
     than Hero + Projects instead of being capped to match them. */
  @media (min-width: 700px) {
    .experience-preview {
      height: 600px;
    }
  }

  .experience-preview__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .experience-preview__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .experience-preview__back :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .experience-preview__back:hover {
    color: var(--color-accent-teal);
  }

  .experience-preview__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow-y: auto;
    min-height: 0;
  }

  .experience-preview__row {
    width: 100%;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .experience-preview__row:hover,
  .experience-preview__row:focus-visible {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  /* .logo-tile (global.css) covers this row's logo/monogram tile. */

  .experience-preview__row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .experience-preview__row-line1 {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .experience-preview__row-line2 {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .experience-preview__detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 0;
    flex: 1;
  }

  .experience-preview__detail-title {
    font-weight: 700;
  }

  .experience-preview__detail-dates {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .experience-preview__detail-oneliner {
    color: var(--color-text-muted);
  }

  .experience-preview__detail-bullets-wrap {
    position: relative;
    overflow: hidden;
    flex: 1;
    min-height: 2.6rem;
  }

  .experience-preview__detail-bullets-wrap.is-truncated::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 2.5rem;
    background: linear-gradient(to bottom, transparent, var(--color-surface));
    pointer-events: none;
  }

  .experience-preview__detail-bullets {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  /* .bento-seemore (global.css) covers the "See more" link's styling. */
</style>

<script>
  import { playEnterAnimation } from "../utils/motion";

  type EntrySummary = {
    slug: string;
    kind: "work" | "education";
    titleLine: string;
    dates: string;
    oneLiner: string;
    metricChips: string[];
    pills: string[];
    bullets: string[];
  };

  const root = document.getElementById("experience-preview");
  const heading = root?.querySelector<HTMLElement>("[data-preview-heading]");
  const backBtn = root?.querySelector<HTMLButtonElement>("[data-preview-back]");
  const list = root?.querySelector<HTMLElement>("[data-preview-list]");
  const detail = root?.querySelector<HTMLElement>("[data-preview-detail]");
  const detailTitle = root?.querySelector<HTMLElement>("[data-detail-title]");
  const detailDates = root?.querySelector<HTMLElement>("[data-detail-dates]");
  const detailOneliner = root?.querySelector<HTMLElement>("[data-detail-oneliner]");
  const detailChips = root?.querySelector<HTMLElement>("[data-detail-chips]");
  const detailBulletsWrap = root?.querySelector<HTMLElement>("[data-detail-bullets-wrap]");
  const detailBullets = root?.querySelector<HTMLElement>("[data-detail-bullets]");
  const detailPills = root?.querySelector<HTMLElement>("[data-detail-pills]");
  const detailSeeMore = root?.querySelector<HTMLAnchorElement>("[data-detail-seemore]");
  const rows = root?.querySelectorAll<HTMLButtonElement>("[data-preview-role]");

  const entryData: EntrySummary[] = JSON.parse(
    document.getElementById("experience-preview-data")?.textContent ?? "[]"
  );

  function fillChipList(container: Element, items: string[], itemClass: string, listClass: string) {
    container.innerHTML = "";
    const ul = document.createElement("ul");
    ul.className = listClass;
    for (const item of items) {
      const li = document.createElement("li");
      li.className = itemClass;
      li.textContent = item;
      ul.appendChild(li);
    }
    container.appendChild(ul);
  }

  function showPreview(slug: string) {
    const entry = entryData.find((e) => e.slug === slug);
    if (!entry || !detail || !list || !heading || !backBtn) return;

    list.hidden = true;
    detail.hidden = false;
    heading.hidden = true;
    backBtn.hidden = false;
    // The header's expand arrow (.experience-preview__expand) intentionally
    // stays a static link to the base /experience route regardless of
    // selection — only "See more" below follows the previewed role.
    playEnterAnimation(detail);

    if (detailTitle) detailTitle.textContent = entry.titleLine;
    if (detailDates) detailDates.textContent = entry.dates;
    if (detailOneliner) detailOneliner.textContent = entry.oneLiner;
    if (detailChips) {
      detailChips.innerHTML = "";
      if (entry.kind === "work" && entry.metricChips.length > 0) {
        fillChipList(detailChips, entry.metricChips.slice(0, 3), "metric-chip", "metric-chips");
      }
    }
    if (detailPills) fillChipList(detailPills, entry.pills.slice(0, 5), "pill", "pill-list pill-list--preview");
    if (detailSeeMore) detailSeeMore.href = `/experience?role=${slug}`;

    if (detailBullets && detailBulletsWrap) {
      detailBullets.innerHTML = "";
      for (const bullet of entry.bullets) {
        const li = document.createElement("li");
        li.textContent = bullet;
        detailBullets.appendChild(li);
      }
      detailBulletsWrap.classList.remove("is-truncated");
      requestAnimationFrame(() => {
        if (detailBulletsWrap.scrollHeight > detailBulletsWrap.clientHeight + 1) {
          detailBulletsWrap.classList.add("is-truncated");
        }
      });
    }
  }

  function showList() {
    if (!list || !detail || !heading || !backBtn) return;
    list.hidden = false;
    detail.hidden = true;
    heading.hidden = false;
    backBtn.hidden = true;
    playEnterAnimation(list);
  }

  rows?.forEach((row) => {
    row.addEventListener("click", () => {
      const slug = row.dataset.previewRole;
      if (slug) showPreview(slug);
    });
  });

  backBtn?.addEventListener("click", showList);
</script>
