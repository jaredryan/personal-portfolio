---
import { Icon } from "astro-icon/components";
import type { Project } from "../data/projects";
// Imported for its is:global CSS only — this component builds pill markup
// by hand (build-time and client-side), but PillList.astro's styles are
// only bundled onto a page when the component module is actually imported.
import PillList from "./PillList.astro";
void PillList;

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const defaultProject = projects[0];
---
<div class="projects-preview" id="projects-preview">
  <div class="projects-preview__header">
    <h2 class="eyebrow">Projects</h2>
    <a class="projects-preview__expand" href="/projects" aria-label="Open full Projects page">
      <Icon name="lucide:arrow-up-right" aria-hidden="true" />
    </a>
  </div>

  <div class="projects-preview__body">
    <div class="projects-preview__media">
      <img
        id="projects-preview-cover"
        src={defaultProject.screenshots.cover}
        alt={`${defaultProject.title} screenshot`}
        width="640"
        height="400"
      />
      <div class="projects-preview__thumbs">
        {projects.map((project) => (
          <button
            type="button"
            class="projects-preview__thumb"
            data-preview-project={project.slug}
            aria-pressed={project.slug === defaultProject.slug ? "true" : "false"}
            aria-label={`Preview ${project.title}`}
            style={{ "--thumb-accent": project.accentColor, "--thumb-accent-dark": project.accentColorDark }}
          >
            <Icon name={project.icon} aria-hidden="true" is:inline />
          </button>
        ))}
      </div>
    </div>

    <div class="projects-preview__info">
      <p class="projects-preview__title" id="projects-preview-title">{defaultProject.title}</p>
      <p class="projects-preview__oneliner prose" id="projects-preview-oneliner">{defaultProject.oneLiner}</p>
      <ul class="pill-list pill-list--preview" id="projects-preview-pills">
        {defaultProject.previewPills.map((pill) => <li class="pill">{pill}</li>)}
      </ul>
      <a class="projects-preview__seemore" data-preview-seemore href={`/projects?project=${defaultProject.slug}`}>See more →</a>
    </div>
  </div>
</div>

<script type="application/json" id="projects-preview-data" set:html={JSON.stringify(
  projects.map((p) => ({
    slug: p.slug,
    title: p.title,
    oneLiner: p.oneLiner,
    previewPills: p.previewPills,
    cover: p.screenshots.cover,
  }))
)} />

<style>
  .projects-preview {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .projects-preview__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .projects-preview__expand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-accent-coral-text);
  }

  .projects-preview__expand :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .projects-preview__expand:hover {
    background: var(--color-surface-alt);
  }

  .projects-preview__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .projects-preview__media {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .projects-preview__media img#projects-preview-cover {
    width: 100%;
    /* height: auto — see ProjectCarousel.astro's carousel__slide comment;
       without it the HTML height attribute overrides aspect-ratio. */
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  /* flex, not a fixed-column grid — a hardcoded column count (this used to
     be repeat(5, 1fr)) silently wraps to a second row the moment a 6th
     project is added, which is exactly what happened. flex:1 per thumb
     below fills the row edge-to-edge with however many projects exist,
     with no column count to keep in sync as the roster grows. */
  .projects-preview__thumbs {
    display: flex;
    gap: var(--space-1);
  }

  /* Each project's own accentColor (src/data/projects.ts) drives both the
     icon and its tile background — full-saturation icon over a light
     color-mix tint of the same hue, the same pattern .pill/.metric-chip use
     for their background/border, just applied to a per-project color
     instead of one shared token. Resting border is a slightly stronger mix
     of that same color for definition; selected/hover still override it
     below with the site's existing coral/teal state colors, unchanged. */
  .projects-preview__thumb {
    flex: 1;
    min-width: 0;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--thumb-accent) 45%, transparent);
    border-radius: var(--radius-sm);
    padding: 0;
    background: color-mix(in srgb, var(--thumb-accent) 10%, var(--color-surface));
    color: var(--thumb-accent);
    cursor: pointer;
    overflow: hidden;
  }

  /* Dark-theme counterpart to the resting-state colors above — a color
     tuned to separate from a light surface doesn't necessarily separate
     from a dark one, so each project supplies its own accentColorDark
     (src/data/projects.ts) rather than reusing accentColor unchanged. */
  :global([data-theme="dark"]) .projects-preview__thumb {
    border-color: color-mix(in srgb, var(--thumb-accent-dark) 45%, transparent);
    background: color-mix(in srgb, var(--thumb-accent-dark) 20%, var(--color-surface));
    color: var(--thumb-accent-dark);
  }

  .projects-preview__thumb :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* astro-icon normally renders repeated icons as a <symbol>+<use> sprite
     for dedup — the <symbol>'s path is never itself painted, only a <use>
     shadow-clone of it is, and that clone isn't reachable by any CSS
     selector, so this rule would silently no-op against the default output.
     The `is:inline` prop on <Icon> above renders the raw <path> directly
     instead (no sprite), which is what makes this actually reach the
     rendered pixels. Lucide bakes stroke-width="2" onto the path itself
     (not the <svg> root), so it has to be targeted directly here — setting
     stroke-width on an ancestor doesn't win over an already-specified
     attribute on the path itself. 1.5px, not 1px — at this icon size (18px,
     scaled down from Lucide's 24-unit viewBox) a full 1px stroke leaves
     small interior details (e.g. the gamepad icon's face) too faint to
     read; 1.5px keeps those legible while still reading thinner than
     Lucide's chunkier default 2px, closer to the row's 1px borders. */
  .projects-preview__thumbs :global(path) {
    stroke-width: 1.5px;
  }

  /* Outline, not a border-color swap — against six different per-project
     border colors, recoloring the border to coral wasn't reliably standing
     out. An offset outline ring is a separate visual layer on top of
     whatever the resting border already is, so it reads clearly regardless
     of which project's own accent color is underneath. */
  .projects-preview__thumb[aria-pressed="true"] {
    outline: 2px solid var(--color-accent-coral);
    outline-offset: 1px;
  }

  /* :not([aria-pressed="true"]) keeps the selected (coral) state visually
     dominant even while that same thumbnail is hovered/focused — selected
     and hover are deliberately distinct signals. Hover/focus deliberately
     overrides the per-project accent with the site's one universal
     interactive-hover treatment (same teal border + icon + surface-alt fill
     as .hero-card__icon-btn and .experience-preview__row) — the colorful
     per-project identity is a resting-state signal; hovering any of them
     reads the same, consistent way regardless of which project it is. */
  .projects-preview__thumb:not([aria-pressed="true"]):hover,
  .projects-preview__thumb:not([aria-pressed="true"]):focus-visible {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
    color: var(--color-accent-teal);
  }

  .projects-preview__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .projects-preview__title {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .projects-preview__oneliner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* Matches .experience-preview__seemore exactly — same contextual-deep-link
     pattern: coral base color, subtle surface-alt hover, distinct from the
     header's expand arrow which always points at the base /projects route. */
  .projects-preview__seemore {
    align-self: flex-start;
    margin-top: var(--space-2);
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    color: var(--color-accent-coral-text);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .projects-preview__seemore:hover,
  .projects-preview__seemore:focus-visible {
    background: var(--color-surface-alt);
  }

  /* min-aspect-ratio matches BentoDashboard's own desktop-tier condition —
     the media/info row-split assumes the full desktop-width column. In the
     tablet-portrait tier this card sits side by side with Experience
     instead, at roughly half width, where the screenshot naturally reads
     better stacked above the text (same as the mobile default below). */
  @media (min-width: 950px) and (min-aspect-ratio: 4/5) {
    .projects-preview__body {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .projects-preview__media {
      width: 42%;
      flex-shrink: 0;
    }

    .projects-preview__info {
      flex: 1;
    }
  }
</style>

<script>
  import { playEnterAnimation } from "../utils/motion";

  type PreviewProject = {
    slug: string;
    title: string;
    oneLiner: string;
    previewPills: string[];
    cover: string;
  };

  const data: PreviewProject[] = JSON.parse(
    document.getElementById("projects-preview-data")?.textContent ?? "[]"
  );

  // Scoped to this component's own root — ExperiencePreview.astro uses the
  // same attribute-based selectors (e.g. `[data-preview-project]`'s sibling
  // `[data-preview-role]`) for its own preview state, so an unscoped
  // document-wide query here risks silently grabbing Experience's elements
  // instead (whichever renders first in the DOM wins). Caught live once
  // already with the header expand link before it was made static.
  const root = document.getElementById("projects-preview");
  const cover = root?.querySelector<HTMLImageElement>("#projects-preview-cover");
  const info = root?.querySelector<HTMLElement>(".projects-preview__info");
  const title = root?.querySelector<HTMLElement>("#projects-preview-title");
  const oneLiner = root?.querySelector<HTMLElement>("#projects-preview-oneliner");
  const pillsList = root?.querySelector<HTMLElement>("#projects-preview-pills");
  const seeMoreLink = root?.querySelector<HTMLAnchorElement>("[data-preview-seemore]");
  const thumbs = root?.querySelectorAll<HTMLButtonElement>("[data-preview-project]");

  function selectPreview(slug: string) {
    const project = data.find((p) => p.slug === slug);
    if (!project || !cover || !title || !oneLiner || !pillsList) return;

    cover.src = project.cover;
    cover.alt = `${project.title} screenshot`;
    title.textContent = project.title;
    oneLiner.textContent = project.oneLiner;
    pillsList.innerHTML = "";
    for (const pill of project.previewPills) {
      const li = document.createElement("li");
      li.className = "pill";
      li.textContent = pill;
      pillsList.appendChild(li);
    }
    // The header's expand arrow (.projects-preview__expand) intentionally
    // stays a static link to the base /projects route regardless of
    // selection — only this contextual "See more" link follows the
    // currently previewed project.
    if (seeMoreLink) seeMoreLink.href = `/projects?project=${slug}`;

    playEnterAnimation(cover);
    playEnterAnimation(info);

    thumbs?.forEach((thumb) => {
      thumb.setAttribute("aria-pressed", String(thumb.dataset.previewProject === slug));
    });
  }

  thumbs?.forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const slug = thumb.dataset.previewProject;
      if (slug) selectPreview(slug);
    });
  });
</script>
