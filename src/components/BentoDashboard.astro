---
import HeroCard from "./HeroCard.astro";
import ExperiencePreview from "./ExperiencePreview.astro";
import ProjectsPreview from "./ProjectsPreview.astro";
import { experience } from "../data/experience";
import { projects } from "../data/projects";
---
<section id="dashboard" class="bento page-shell" aria-label="Overview">
  <script is:inline>
    // Synchronous + is:inline so this runs before the cards below paint —
    // same FOUC-avoidance trick BaseLayout's theme script uses. Picks the
    // more expressive "first" entrance once per browser session (tracked in
    // sessionStorage) and falls back to the muted "repeat" entrance for
    // every dashboard load after that.
    (function () {
      var section = document.currentScript.parentElement;
      var STORAGE_KEY = "bentoEntrancePlayed";
      var alreadyPlayed = false;
      try {
        alreadyPlayed = sessionStorage.getItem(STORAGE_KEY) === "1";
        sessionStorage.setItem(STORAGE_KEY, "1");
      } catch (e) {}
      section.classList.add(alreadyPlayed ? "bento--enter-repeat" : "bento--enter-first");
    })();
  </script>
  <HeroCard />
  <ExperiencePreview entries={experience} />
  <ProjectsPreview projects={projects} />
</section>

<script>
  // Desktop-tier height sync for the Experience card. In that tier (see the
  // .bento media query below) Experience spans both grid rows and needs to
  // match Hero + gap + Projects' natural stacked height exactly — but a
  // plain CSS height: 100% can't express that. It's circular: 100% is
  // indefinite until the grid resolves the very row it's meant to fill, so
  // the grid falls back to Experience's own intrinsic content size to help
  // decide that row's height. A long detail view then inflates the row
  // instead of being capped by it, growing Experience taller than Hero +
  // Projects rather than matching them (ExperiencePreview.astro's own
  // height: 600px at that width is only a pre-JS fallback for this reason).
  // Measuring Hero + Projects directly and setting an explicit inline pixel
  // height on Experience sidesteps the circularity entirely.
  const section = document.getElementById("dashboard");
  const hero = section?.querySelector<HTMLElement>(".hero-card");
  const projectsCard = section?.querySelector<HTMLElement>(".projects-preview");
  const experience = section?.querySelector<HTMLElement>(".experience-preview");

  if (section && hero && projectsCard && experience) {
    // Rebind to new consts: TS doesn't carry this null-narrowing into the
    // nested function below (it can't prove the closure runs before these
    // could change), so the closure needs variables that are non-null from
    // their own declaration, not narrowed after the fact.
    const sectionEl = section;
    const heroEl = hero;
    const projectsEl = projectsCard;
    const experienceEl = experience;
    const desktopQuery = window.matchMedia("(min-width: 950px) and (min-aspect-ratio: 4/5)");

    function syncExperienceHeight() {
      if (!desktopQuery.matches) {
        // Below the desktop tier, ExperiencePreview.astro's own CSS heights
        // (phone default / 700px+ tablet value) apply — don't fight them.
        experienceEl.style.removeProperty("height");
        return;
      }
      const rowGap = parseFloat(getComputedStyle(sectionEl).rowGap) || 0;
      const total = heroEl.getBoundingClientRect().height + rowGap + projectsEl.getBoundingClientRect().height;
      experienceEl.style.height = `${total}px`;
    }

    // Observes Hero/Projects, not Experience itself — observing the card
    // this script is busy resizing would set up a feedback loop.
    const resizeObserver = new ResizeObserver(syncExperienceHeight);
    resizeObserver.observe(heroEl);
    resizeObserver.observe(projectsEl);
    desktopQuery.addEventListener("change", syncExperienceHeight);
    syncExperienceHeight();
  }
</script>

<style>
  /*
   * Source order above is Hero, ExperiencePreview, ProjectsPreview — this is
   * also the required mobile/no-CSS/screen-reader order. Three visual
   * layouts, all achieved purely through grid-template-areas (never by
   * reordering the DOM to fake a visual layout, which would desync what
   * mobile/screen readers see from what sighted users see):
   *
   *  - Phone/mobile (default, no media query matches): single column,
   *    simply follows DOM order — Hero, Experience, Projects.
   *  - Tablet/medium (700–949px wide, any shape — this range is below the
   *    desktop tier's own width floor, so it can never collide with it —
   *    plus 950px+ but tall/portrait-shaped, e.g. iPad portrait): Hero
   *    full-width on top, Experience and Projects side by side below.
   *    This is also what a laptop browser narrowed to "look at two things
   *    at once" lands in — nothing here is iPad-specific, it's purely
   *    viewport width/shape, so any window in this range gets it.
   *  - Laptop/desktop (950px+ AND landscape-ish): Hero top-left, Projects
   *    bottom-left, Experience spanning the full-height right column.
   *
   * The two conditions in the tablet/medium query below are OR'd via the
   * comma: either the width alone puts it below the desktop tier's floor,
   * or (once wide enough to reach that floor) the shape is still
   * portrait-ish rather than landscape. That second clause is what keeps
   * a tall, narrow desktop-width viewport (e.g. iPad Pro 12.9" portrait)
   * out of the desktop tier instead of getting squeezed into it.
   */
  .bento {
    display: grid;
    /* minmax(0, 1fr), not bare 1fr — a bare 1fr track won't shrink below the
       min-content width of its contents (e.g. nowrap spine-row text), which
       silently forces the whole grid — and page — wider than the viewport. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .bento :global(.hero-card),
  .bento :global(.experience-preview),
  .bento :global(.projects-preview) {
    min-width: 0;
  }

  @media (min-width: 700px) and (max-width: 949px), (min-width: 950px) and (max-aspect-ratio: 4/5) {
    .bento {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "hero hero"
        "experience projects";
    }

    .bento :global(.hero-card) {
      grid-area: hero;
    }

    .bento :global(.experience-preview) {
      grid-area: experience;
    }

    .bento :global(.projects-preview) {
      grid-area: projects;
    }
  }

  @media (min-width: 950px) and (min-aspect-ratio: 4/5) {
    .bento {
      /* Overrides BaseLayout.astro's default main > * { min-height: 100% }
         back to auto here on purpose — forcing the grid taller than its
         content (to "fill the viewport") would decouple Hero/Projects'
         rendered height from their actual content, which this file's
         height-sync script above measures directly via
         getBoundingClientRect() to size Experience (which spans both grid
         rows). Sizing the grid purely from content keeps that measurement
         meaningful instead of reading an artificially stretched height. */
      min-height: auto;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "hero experience"
        "projects experience";
      align-items: start;
    }

    .bento :global(.hero-card) {
      grid-area: hero;
    }

    .bento :global(.experience-preview) {
      /* No height here (previously height: 100%, the same circular grid
         sizing this file's height-sync script above exists to fix) —
         Experience's height at this tier now comes from that script's
         inline style, with ExperiencePreview.astro's own scoped height:
         600px as its pre-JS fallback. */
      grid-area: experience;
      min-width: 305px;
    }

    .bento :global(.projects-preview) {
      grid-area: projects;
    }
  }

  /* Entrance "settle" animation, transform + opacity only (no layout
     properties, so nothing reflows). Two variants toggled by the inline
     script above via a class on .bento itself:
       - bento--enter-first: session's first dashboard load only — never
         repeats for a returning visitor, so this is the one place the
         dashboard is allowed a bit more personality. Hero leads,
         Experience/Projects follow on a clearer stagger, with a touch of
         overshoot in the easing (see bento-settle-first below) rather than
         a flat settle.
       - bento--enter-repeat: every later dashboard load this session. A
         single quick fade/nudge, no stagger, reusing the same
         motion-fade-up keyframe the rest of the site uses for content
         swaps (see utils/motion.ts) — this is the restraint that keeps the
         more expressive first-load version from becoming annoying.
     prefers-reduced-motion is already handled globally (global.css clamps
     every animation-duration to ~0), so no separate override is needed
     here — both variants collapse to a near-instant, transform-free swap
     for those users automatically. */
  @keyframes bento-settle-first {
    from {
      opacity: 0;
      transform: translateY(18px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .bento--enter-first :global(.hero-card) {
    animation: bento-settle-first 480ms cubic-bezier(0.22, 1.15, 0.36, 1) both;
  }

  .bento--enter-first :global(.experience-preview) {
    animation: bento-settle-first 480ms cubic-bezier(0.22, 1.15, 0.36, 1) 100ms both;
  }

  .bento--enter-first :global(.projects-preview) {
    animation: bento-settle-first 480ms cubic-bezier(0.22, 1.15, 0.36, 1) 200ms both;
  }

  .bento--enter-repeat :global(.hero-card),
  .bento--enter-repeat :global(.experience-preview),
  .bento--enter-repeat :global(.projects-preview) {
    animation: motion-fade-up 260ms ease-out both;
  }
</style>
