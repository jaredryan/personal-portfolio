---
import HeroCard from "./HeroCard.astro";
import ExperiencePreview from "./ExperiencePreview.astro";
import ProjectsPreview from "./ProjectsPreview.astro";
import { experience } from "../data/experience";
import { projects } from "../data/projects";
---
<section id="dashboard" class="bento page-shell" aria-label="Overview">
  <script is:inline>
    // Synchronous + is:inline so this runs before the cards below paint —
    // same FOUC-avoidance trick BaseLayout's theme script uses. Picks the
    // more expressive "first" entrance once per browser session (tracked in
    // sessionStorage) and falls back to the muted "repeat" entrance for
    // every dashboard load after that.
    (function () {
      var section = document.currentScript.parentElement;
      var STORAGE_KEY = "bentoEntrancePlayed";
      var alreadyPlayed = false;
      try {
        alreadyPlayed = sessionStorage.getItem(STORAGE_KEY) === "1";
        sessionStorage.setItem(STORAGE_KEY, "1");
      } catch (e) {}
      section.classList.add(alreadyPlayed ? "bento--enter-repeat" : "bento--enter-first");
    })();
  </script>
  <HeroCard />
  <ExperiencePreview entries={experience} />
  <ProjectsPreview projects={projects} />
</section>

<style>
  /*
   * Source order above is Hero, ExperiencePreview, ProjectsPreview — this is
   * also the required mobile/no-CSS/screen-reader order. Three visual
   * layouts, all achieved purely through grid-template-areas (never by
   * reordering the DOM to fake a visual layout, which would desync what
   * mobile/screen readers see from what sighted users see):
   *
   *  - Phone/mobile (default, no media query matches): single column,
   *    simply follows DOM order — Hero, Experience, Projects.
   *  - Tablet/medium (700–949px wide, any shape — this range is below the
   *    desktop tier's own width floor, so it can never collide with it —
   *    plus 950px+ but tall/portrait-shaped, e.g. iPad portrait): Hero
   *    full-width on top, Experience and Projects side by side below.
   *    This is also what a laptop browser narrowed to "look at two things
   *    at once" lands in — nothing here is iPad-specific, it's purely
   *    viewport width/shape, so any window in this range gets it.
   *  - Laptop/desktop (950px+ AND landscape-ish): Hero top-left, Projects
   *    bottom-left, Experience spanning the full-height right column.
   *
   * The two conditions in the tablet/medium query below are OR'd via the
   * comma: either the width alone puts it below the desktop tier's floor,
   * or (once wide enough to reach that floor) the shape is still
   * portrait-ish rather than landscape. That second clause is what keeps
   * a tall, narrow desktop-width viewport (e.g. iPad Pro 12.9" portrait)
   * out of the desktop tier instead of getting squeezed into it.
   */
  .bento {
    display: grid;
    /* minmax(0, 1fr), not bare 1fr — a bare 1fr track won't shrink below the
       min-content width of its contents (e.g. nowrap spine-row text), which
       silently forces the whole grid — and page — wider than the viewport. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .bento :global(.hero-card),
  .bento :global(.experience-preview),
  .bento :global(.projects-preview) {
    min-width: 0;
  }

  @media (min-width: 700px) and (max-width: 949px), (min-width: 950px) and (max-aspect-ratio: 4/5) {
    .bento {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "hero hero"
        "experience projects";
    }

    .bento :global(.hero-card) {
      grid-area: hero;
    }

    .bento :global(.experience-preview) {
      grid-area: experience;
    }

    .bento :global(.projects-preview) {
      grid-area: projects;
    }
  }

  @media (min-width: 950px) and (min-aspect-ratio: 4/5) {
    .bento {
      /* No min-height here on purpose — forcing the grid taller than its
         content (to "fill the viewport") decouples the row tracks from
         Hero + Projects' actual height, so Experience's height: 100% (which
         spans both rows) ends up taller than Hero + gap + Projects instead
         of matching it. Sizing purely from content keeps them in sync. */
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "hero experience"
        "projects experience";
      align-items: start;
    }

    .bento :global(.hero-card) {
      grid-area: hero;
    }

    .bento :global(.experience-preview) {
      grid-area: experience;
      height: 100%;
    }

    .bento :global(.projects-preview) {
      grid-area: projects;
    }
  }

  /* Entrance "settle" animation, transform + opacity only (no layout
     properties, so nothing reflows). Two variants toggled by the inline
     script above via a class on .bento itself:
       - bento--enter-first: session's first dashboard load. Hero leads,
         Experience/Projects follow on a short stagger. More expressive but
         still quick — see bento-settle-first below.
       - bento--enter-repeat: every later dashboard load this session. A
         single quick fade/nudge, no stagger, reusing the same
         motion-fade-up keyframe the rest of the site uses for content
         swaps (see utils/motion.ts).
     prefers-reduced-motion is already handled globally (global.css clamps
     every animation-duration to ~0), so no separate override is needed
     here — both variants collapse to a near-instant, transform-free swap
     for those users automatically. */
  @keyframes bento-settle-first {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .bento--enter-first :global(.hero-card) {
    animation: bento-settle-first 420ms ease-out both;
  }

  .bento--enter-first :global(.experience-preview) {
    animation: bento-settle-first 420ms ease-out 70ms both;
  }

  .bento--enter-first :global(.projects-preview) {
    animation: bento-settle-first 420ms ease-out 140ms both;
  }

  .bento--enter-repeat :global(.hero-card),
  .bento--enter-repeat :global(.experience-preview),
  .bento--enter-repeat :global(.projects-preview) {
    animation: motion-fade-up 260ms ease-out both;
  }
</style>
