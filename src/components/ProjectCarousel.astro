---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";

interface Props {
  images: string[];
  alt: string;
  autoRotateMs?: number;
  /** Lucide icon name shown inline in the caption row ("[icon] Preview N
   * of M") — reuses the same icon already shown for this project in the
   * switcher tab, so the identity carries from tab to screenshot without
   * overlaying the image itself. Purely a visual tie-back (the project
   * name is already announced by the tab/heading), so it's aria-hidden
   * rather than adding a redundant label. */
  icon?: string;
  /** When set, a Play button appears next to Expand and opens the lightbox
   * in "game" mode with a live iframe of this URL instead of a screenshot.
   * The iframe is not created until Play is clicked. */
  playableEmbedUrl?: string;
  playableLabel?: string;
  playableIframeTitle?: string;
}

const { images, alt, autoRotateMs = 6000, icon, playableEmbedUrl, playableLabel, playableIframeTitle } = Astro.props;
const playLabel = playableLabel ?? `Play ${alt}`;
const playIframeTitle = playableIframeTitle ?? `${alt} — playable game`;

// Large gallery screenshots (the ~2940px originals) have a same-directory
// "-md.webp" sibling generated at build-prep time (1400px wide) — used for
// normal in-panel display via srcset, while `src` itself stays reserved for
// the lightbox's fullscreen view (see data-full-src below and this
// component's script, which reads that attribute rather than the resolved
// <img>.src — with srcset present, .src reflects whichever candidate the
// browser actually picked, which would otherwise leak the smaller image
// into the lightbox). The project cover (also passed in as this carousel's
// first slide from ProjectDetailView) is already right-sized on its own and
// has no "-md" sibling, so this checks the file actually exists before
// using it rather than assuming every slide follows the same convention.
function mdSrc(src: string): string | null {
  const candidate = src.replace(/\.webp$/, "-md.webp");
  return fs.existsSync(path.join(process.cwd(), "public", candidate)) ? candidate : null;
}
---
<div class="carousel" data-carousel data-autorotate-ms={autoRotateMs}>
  <div class="carousel__viewport">
    {images.map((src, index) => {
      const md = mdSrc(src);
      return (
      <img
        src={md ?? src}
        srcset={md ? `${md} 1400w, ${src} 2940w` : undefined}
        sizes={md ? "(min-width: 1280px) 700px, 90vw" : undefined}
        data-full-src={md ? src : undefined}
        alt={`${alt} — screenshot ${index + 1} of ${images.length}`}
        class="carousel__slide"
        data-slide-index={index}
        hidden={index !== 0}
        loading={index === 0 ? "eager" : "lazy"}
        width="960"
        height="600"
      />
      );
    })}
    <div class="carousel__viewport-actions">
      {playableEmbedUrl && (
        <button type="button" class="carousel__action-btn" data-carousel-play data-embed-url={playableEmbedUrl} aria-label={playLabel}>
          <Icon name="lucide:play" aria-hidden="true" />
        </button>
      )}
      <button type="button" class="carousel__action-btn" data-carousel-expand aria-label="Expand screenshot">
        <Icon name="lucide:arrow-up-right" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="carousel__lightbox" data-carousel-lightbox hidden>
    <button type="button" class="carousel__lightbox-backdrop" data-lightbox-backdrop aria-label="Close expanded view"></button>
    {images.length > 1 && (
      <button type="button" class="carousel__lightbox-nav carousel__lightbox-nav--prev" data-lightbox-prev aria-label="Previous screenshot">
        <Icon name="lucide:chevron-left" aria-hidden="true" />
      </button>
    )}
    <div class="carousel__lightbox-panel" data-lightbox-panel role="dialog" aria-modal="true" aria-label={`${alt} screenshot, expanded view`} data-label-screenshot={`${alt} screenshot, expanded view`} data-label-game={playLabel}>
      <button type="button" class="carousel__lightbox-close" data-lightbox-close aria-label="Close expanded view">
        <Icon name="lucide:x" aria-hidden="true" />
      </button>
      <img data-lightbox-img alt="" />
      {images.length > 1 && (
        <p class="carousel__lightbox-caption" data-lightbox-caption aria-live="polite"></p>
      )}
      {playableEmbedUrl && (
        <div class="carousel__lightbox-game" data-lightbox-game hidden>
          <iframe data-lightbox-iframe title={playIframeTitle} allow="gamepad; fullscreen" allowfullscreen></iframe>
        </div>
      )}
    </div>
    {images.length > 1 && (
      <button type="button" class="carousel__lightbox-nav carousel__lightbox-nav--next" data-lightbox-next aria-label="Next screenshot">
        <Icon name="lucide:chevron-right" aria-hidden="true" />
      </button>
    )}
  </div>

  <div class="carousel__controls">
    <button type="button" class="carousel__prev" aria-label="Previous screenshot">
      <Icon name="lucide:chevron-left" aria-hidden="true" />
    </button>
    <div class="carousel__dots" role="group" aria-label="Screenshot selector">
      {images.map((_, index) => (
        <button
          type="button"
          class="carousel__dot"
          aria-current={index === 0 ? "true" : undefined}
          aria-label={`Show screenshot ${index + 1}`}
          data-dot-index={index}
        >
          <div class="carousel__dot-visual"></div>
        </button>
      ))}
    </div>
    <button type="button" class="carousel__next" aria-label="Next screenshot">
      <Icon name="lucide:chevron-right" aria-hidden="true" />
    </button>
  </div>

  <p class="carousel__caption" data-carousel-caption aria-live="polite">
    {icon && <Icon name={icon} class="carousel__caption-icon" aria-hidden="true" />}
    <span data-carousel-caption-text>Preview 1 of {images.length}</span>
  </p>
</div>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .carousel__viewport {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    /* Slides are stacked with position: absolute below so the outgoing and
       incoming slide can overlap mid-transition — the viewport itself now
       owns the aspect ratio that used to live on the (in-flow) <img>. */
    aspect-ratio: 16 / 10;
    /* Tells the browser this element only needs native panning vertically —
       a horizontal drag is left for the pointer-event swipe handlers below
       instead of the browser trying to interpret it as a page gesture,
       which is what lets pointerup reliably fire with the full delta. */
    touch-action: pan-y;
  }

  .carousel__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateX(0);
    opacity: 1;
    transition: transform 260ms ease-out, opacity 260ms ease-out;
  }

  /* Shared offset used both as the incoming slide's starting point and the
     outgoing slide's ending point for a given direction, so two classes
     cover all four transition roles (next-enter/prev-exit share one,
     prev-enter/next-exit share the other). */
  .carousel__slide--from-right {
    transform: translateX(28px);
    opacity: 0;
  }

  .carousel__slide--from-left {
    transform: translateX(-28px);
    opacity: 0;
  }

  .carousel__viewport-actions {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .carousel__action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .carousel__action-btn :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__action-btn:hover {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .carousel__caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* Quiet identity marker inline with the counter, not overlaying the
     screenshot — currentColor keeps it the same muted tone as the text. */
  .carousel__caption-icon {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
    color: currentColor;
  }

  .carousel__lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .carousel__lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, black 65%, transparent);
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .carousel__lightbox-panel {
    position: relative;
    z-index: 1;
    max-width: min(1100px, 92vw);
    max-height: 88vh;
  }

  .carousel__lightbox-panel img {
    display: block;
    max-width: 100%;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  /* Game mode swaps the screenshot for a large iframe. Unlike the image
     (which is sized by its own intrinsic aspect ratio via object-fit), a
     game has no natural size, so the panel itself becomes the one explicit
     box — game/iframe below just stretch to fill it via flex. Giving the
     panel and the iframe each their own independent vw/vh calculation
     (as this used to do) let them drift a pixel apart at some viewport
     sizes, leaving the iframe's own background visible as a seam along one
     edge. Sized generously (bigger than the screenshot panel's cap) since
     gameplay needs real room. */
  .carousel__lightbox-panel--game {
    display: flex;
    width: min(1000px, 90vw);
    height: min(700px, 82vh);
  }

  .carousel__lightbox-game {
    width: 100%;
    height: 100%;
    flex: 1;
  }

  .carousel__lightbox-game iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: var(--radius-md);
  }

  /* Below tablet width, let the lightbox use basically the full screen —
     the fixed vw/vh caps above leave far more unused edge space than a
     small phone viewport can spare. The outer lightbox padding is zeroed
     out too, so --space-7 (on the panel itself, on all sides) is the only
     margin, sized just large enough that the close button's overhang never
     gets clipped by the screen edge. */
  @media (max-width: 767px) {
    .carousel__lightbox {
      padding: 0;
    }

    .carousel__lightbox-panel {
      max-width: calc(100vw - (var(--space-7) * 2));
      max-height: calc(100vh - (var(--space-7) * 2));
    }

    .carousel__lightbox-panel img {
      max-height: calc(100vh - (var(--space-7) * 2));
    }

    .carousel__lightbox-panel--game {
      width: calc(100vw - (var(--space-7) * 2));
      height: calc(100vh - (var(--space-7) * 2));
    }
  }

  .carousel__lightbox-close {
    position: absolute;
    top: calc(-1 * var(--space-4));
    right: calc(-1 * var(--space-4));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
  }

  .carousel__lightbox-close :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__lightbox-close:hover {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  /* Anchored to the lightbox overlay itself (not the panel) so the arrows
     sit near the screen edges regardless of how wide the image/panel is. */
  .carousel__lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
  }

  .carousel__lightbox-nav :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .carousel__lightbox-nav:hover,
  .carousel__lightbox-nav:focus-visible {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .carousel__lightbox-nav--prev {
    left: var(--space-4);
  }

  .carousel__lightbox-nav--next {
    right: var(--space-4);
  }

  .carousel__lightbox-caption {
    margin-top: var(--space-3);
    text-align: center;
    font-size: 0.8rem;
    /* Fixed light tone rather than the theme token: the lightbox backdrop
       is always a dark overlay regardless of light/dark mode, so the muted
       text color (dark in light mode) would be unreadable against it. */
    color: rgba(255, 255, 255, 0.85);
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .carousel__prev,
  .carousel__next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .carousel__prev :global(svg),
  .carousel__next :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__prev:hover,
  .carousel__prev:focus-visible,
  .carousel__next:hover,
  .carousel__next:focus-visible {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .carousel__dots {
    display: flex;
    gap: var(--space-2);
  }

  /* 24x24px hit target (WCAG 2.2's minimum) wrapping the visible dot — the
     dot itself (.carousel__dot-visual below) stays its original small size,
     centered inside. Fixed size also guarantees adjacent dots' hit areas
     never overlap regardless of gap. */
  .carousel__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-6);
    height: var(--space-6);
    border: none;
    background: none;
    cursor: pointer;
    padding: 0;
  }

  .carousel__dot-visual {
    width: var(--space-4);
    height: var(--space-4);
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  /* :not([aria-current]) keeps the selected (coral) dot dominant even while
     it's hovered/focused — matches the same selected-vs-hover precedent as
     .projects-preview__thumb. */
  .carousel__dot:not([aria-current]):hover .carousel__dot-visual,
  .carousel__dot:not([aria-current]):focus-visible .carousel__dot-visual {
    border-color: var(--color-accent-teal);
    background: var(--color-accent-teal);
  }

  .carousel__dot[aria-current] .carousel__dot-visual {
    background: var(--color-accent-coral);
    border-color: var(--color-accent-coral);
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ProjectsSection (Task 13) pre-renders all 5 project detail panels at once
  // and toggles each one's `hidden` attribute — it does not unmount/remount
  // this component. Without the visibility awareness below, every carousel's
  // setInterval would start immediately on page load and keep advancing while
  // its panel is hidden, so by the time a user opens a given project its
  // carousel would already be on some arbitrary slide, and 5 timers would be
  // running in the background for no visible benefit. Each carousel instead
  // only runs while the `[data-project-detail]` panel that contains it is
  // visible, and resets to slide 0 each time that panel becomes visible.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>(".carousel__slide"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>(".carousel__dot"));
    const prevBtn = carousel.querySelector<HTMLButtonElement>(".carousel__prev");
    const nextBtn = carousel.querySelector<HTMLButtonElement>(".carousel__next");
    const autoRotateMs = Number(carousel.dataset.autorotateMs ?? 0);
    // Matches both the mobile detail panel (data-project-detail) and the
    // desktop/tablet showcase panel (data-project-detail-showcase) — the
    // same project can have a carousel instance rendered in each
    // simultaneously, only one of which is ever actually visible at a
    // given viewport width.
    const panel = carousel.closest<HTMLElement>("[data-project-detail], [data-project-detail-showcase]");
    const viewport = carousel.querySelector<HTMLElement>(".carousel__viewport");
    const captionText = carousel.querySelector<HTMLElement>("[data-carousel-caption-text]");
    const expandBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-expand]");
    const playBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-play]");
    const lightbox = carousel.querySelector<HTMLElement>("[data-carousel-lightbox]");
    const lightboxPanel = lightbox?.querySelector<HTMLElement>("[data-lightbox-panel]");
    const lightboxImg = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const lightboxClose = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const lightboxBackdrop = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-backdrop]");
    const lightboxPrev = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const lightboxNext = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    const lightboxCaption = lightbox?.querySelector<HTMLElement>("[data-lightbox-caption]");
    const lightboxGame = lightbox?.querySelector<HTMLElement>("[data-lightbox-game]");
    const lightboxIframe = lightboxGame?.querySelector<HTMLIFrameElement>("[data-lightbox-iframe]");
    const playableEmbedUrl = playBtn?.dataset.embedUrl;
    let current = 0;
    let timerId: ReturnType<typeof setInterval> | undefined;
    let lightboxOpener: HTMLButtonElement | null = null;

    function isPanelVisible(): boolean {
      return !panel || !panel.hidden;
    }

    // direction is "next"/"previous" for an explicit prev/next click, a
    // computed next/previous for dot clicks that skip forward or back, or
    // null when there's no meaningful direction (dot click landing on the
    // current slide, or the auto-reset to slide 0 when a project panel
    // opens) — null just crossfades via the hidden toggle, no slide.
    function show(index: number, direction: "next" | "previous" | null = null) {
      const nextIndex = (index + slides.length) % slides.length;
      if (nextIndex === current) return;

      const outgoing = slides[current];
      const incoming = slides[nextIndex];
      current = nextIndex;

      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      if (captionText) captionText.textContent = `Preview ${current + 1} of ${slides.length}`;

      if (!direction) {
        outgoing.hidden = true;
        incoming.hidden = false;
        incoming.classList.remove("carousel__slide--from-right", "carousel__slide--from-left");
        return;
      }

      const enterClass = direction === "next" ? "carousel__slide--from-right" : "carousel__slide--from-left";
      const exitClass = direction === "next" ? "carousel__slide--from-left" : "carousel__slide--from-right";

      incoming.classList.remove("carousel__slide--from-right", "carousel__slide--from-left");
      incoming.hidden = false;
      incoming.classList.add(enterClass);
      // Force layout so the offset start-state is committed before removing
      // it triggers a transition — otherwise there's no "from" value to
      // animate from and the slide just appears already in place.
      void incoming.offsetWidth;
      incoming.classList.remove(enterClass);
      outgoing.classList.add(exitClass);

      outgoing.addEventListener(
        "transitionend",
        () => {
          outgoing.hidden = true;
          outgoing.classList.remove(exitClass);
        },
        { once: true },
      );
    }

    function startAutoRotate() {
      if (prefersReducedMotion || !autoRotateMs || slides.length < 2 || !isPanelVisible()) return;
      stopAutoRotate();
      timerId = setInterval(() => show(current + 1, "next"), autoRotateMs);
    }

    function stopAutoRotate() {
      if (timerId) clearInterval(timerId);
      timerId = undefined;
    }

    // Keeps the lightbox's own image/caption in sync with `current` — used
    // both when opening (to seed it) and whenever prev/next/swipe navigate
    // while the lightbox is open, so the regular carousel index (dots,
    // caption, and the slide it resumes on if closed) never drifts from
    // what's shown expanded.
    function syncLightbox() {
      const activeSlide = slides[current];
      if (!lightboxImg || !activeSlide) return;
      // data-full-src, not .src — with srcset present, .src reflects
      // whichever candidate the browser picked for the small in-panel
      // display, not necessarily the original full-resolution file.
      lightboxImg.src = activeSlide.dataset.fullSrc ?? activeSlide.src;
      lightboxImg.alt = activeSlide.alt;
      if (lightboxCaption) lightboxCaption.textContent = `Preview ${current + 1} of ${slides.length}`;
    }

    function isGameModeActive(): boolean {
      return !!lightboxGame && !lightboxGame.hidden;
    }

    function lightboxShow(direction: "next" | "previous") {
      if (slides.length < 2 || isGameModeActive()) return;
      show(direction === "next" ? current + 1 : current - 1, direction);
      syncLightbox();
    }

    // The panel declares aria-modal="true" (it's a real modal overlay), so
    // Tab must actually stay contained within it — mirrors ContactDrawer's
    // trap. Filters out anything hidden (e.g. the prev/next arrows and
    // caption while game mode is active) rather than relying on querying
    // only currently-visible markup, since the same elements exist in the
    // DOM across both modes and just toggle `hidden`.
    function getLightboxFocusable(): HTMLElement[] {
      if (!lightbox) return [];
      return Array.from(
        lightbox.querySelectorAll<HTMLElement>("a[href], button:not([disabled]), iframe"),
      ).filter((el) => !el.hidden && el.offsetParent !== null);
    }

    function onLightboxKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        closeLightbox();
        return;
      }
      if (event.key === "ArrowLeft") {
        lightboxShow("previous");
        return;
      }
      if (event.key === "ArrowRight") {
        lightboxShow("next");
        return;
      }
      if (event.key !== "Tab") return;
      const focusable = getLightboxFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    let touchStartX = 0;
    let touchStartY = 0;

    function onLightboxTouchStart(event: TouchEvent) {
      const touch = event.touches[0];
      if (!touch) return;
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
    }

    function onLightboxTouchEnd(event: TouchEvent) {
      const touch = event.changedTouches[0];
      if (!touch) return;
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      const SWIPE_THRESHOLD = 40;
      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
        lightboxShow(deltaX < 0 ? "next" : "previous");
      }
    }

    // Swipe support for the main (non-lightbox) preview viewport — Pointer
    // Events cover touch, mouse drag, and pen with one code path. Requires a
    // clearly horizontal gesture (same ratio check as the lightbox above) so
    // an ordinary vertical scroll over the carousel is never hijacked; since
    // this never calls preventDefault, a vertical drag always scrolls the
    // page normally regardless of what's detected here. touch-action: pan-y
    // (see CSS) tells the browser to leave horizontal gestures to us instead
    // of treating them as page panning, so pointerup reliably fires with the
    // full gesture's delta.
    let viewportPointerId: number | null = null;
    let viewportStartX = 0;
    let viewportStartY = 0;

    function onViewportPointerDown(event: PointerEvent) {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      viewportPointerId = event.pointerId;
      viewportStartX = event.clientX;
      viewportStartY = event.clientY;
    }

    function onViewportPointerUp(event: PointerEvent) {
      if (viewportPointerId === null || event.pointerId !== viewportPointerId) return;
      viewportPointerId = null;
      const deltaX = event.clientX - viewportStartX;
      const deltaY = event.clientY - viewportStartY;
      const SWIPE_THRESHOLD = 40;
      if (Math.abs(deltaX) > SWIPE_THRESHOLD && Math.abs(deltaX) > Math.abs(deltaY)) {
        const direction = deltaX < 0 ? "next" : "previous";
        show(direction === "next" ? current + 1 : current - 1, direction);
        startAutoRotate();
      }
    }

    function onViewportPointerCancel() {
      viewportPointerId = null;
    }

    // Toggles which lightbox content is visible without touching `hidden` on
    // the lightbox root itself — screenshot mode shows the image plus its
    // nav arrows/dots-adjacent caption, game mode shows only the iframe and
    // its close button, per the spec's requirement that game mode hide every
    // screenshot-specific control.
    function setLightboxMode(mode: "screenshot" | "game") {
      const isGame = mode === "game";
      if (lightboxImg) lightboxImg.hidden = isGame;
      if (lightboxGame) lightboxGame.hidden = !isGame;
      if (lightboxCaption) lightboxCaption.hidden = isGame;
      if (lightboxPrev) lightboxPrev.hidden = isGame;
      if (lightboxNext) lightboxNext.hidden = isGame;
      if (lightboxPanel) {
        // The panel is the one element that gets an explicit size in game
        // mode (see CSS) — the iframe just stretches to fill it via flex,
        // so the two can never drift a pixel apart.
        lightboxPanel.classList.toggle("carousel__lightbox-panel--game", isGame);
        const label = isGame ? lightboxPanel.dataset.labelGame : lightboxPanel.dataset.labelScreenshot;
        if (label) lightboxPanel.setAttribute("aria-label", label);
      }
    }

    function openLightbox(mode: "screenshot" | "game", opener: HTMLButtonElement | null) {
      if (!lightbox) return;
      lightboxOpener = opener;
      lightbox.hidden = false;
      setLightboxMode(mode);
      if (mode === "game") {
        // Iframe only gets a src (and therefore only starts loading the
        // game) the moment Play is clicked — never on page load.
        if (lightboxIframe && playableEmbedUrl) lightboxIframe.src = playableEmbedUrl;
      } else if (lightboxImg) {
        syncLightbox();
      }
      stopAutoRotate();
      document.addEventListener("keydown", onLightboxKeydown);
      lightboxClose?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      // Unload the game rather than leaving it running (and making sound)
      // off-screen behind the closed lightbox.
      if (lightboxIframe) lightboxIframe.src = "";
      setLightboxMode("screenshot");
      document.removeEventListener("keydown", onLightboxKeydown);
      startAutoRotate();
      (lightboxOpener ?? expandBtn)?.focus();
    }

    expandBtn?.addEventListener("click", () => openLightbox("screenshot", expandBtn));
    playBtn?.addEventListener("click", () => openLightbox("game", playBtn));
    lightboxClose?.addEventListener("click", closeLightbox);
    lightboxBackdrop?.addEventListener("click", closeLightbox);
    lightboxPrev?.addEventListener("click", () => lightboxShow("previous"));
    lightboxNext?.addEventListener("click", () => lightboxShow("next"));
    lightbox?.addEventListener("touchstart", onLightboxTouchStart, { passive: true });
    lightbox?.addEventListener("touchend", onLightboxTouchEnd, { passive: true });
    viewport?.addEventListener("pointerdown", onViewportPointerDown);
    viewport?.addEventListener("pointerup", onViewportPointerUp);
    viewport?.addEventListener("pointercancel", onViewportPointerCancel);

    prevBtn?.addEventListener("click", () => {
      show(current - 1, "previous");
      startAutoRotate();
    });
    nextBtn?.addEventListener("click", () => {
      show(current + 1, "next");
      startAutoRotate();
    });
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        // Infer direction from index so jumping ahead/back several slides
        // via a dot still slides the expected way; landing on the current
        // dot is a no-op inside show() regardless.
        show(i, i > current ? "next" : i < current ? "previous" : null);
        startAutoRotate();
      });
    });

    carousel.addEventListener("mouseenter", stopAutoRotate);
    carousel.addEventListener("mouseleave", startAutoRotate);
    carousel.addEventListener("focusin", stopAutoRotate);
    carousel.addEventListener("focusout", startAutoRotate);

    if (panel) {
      // React to ProjectsSection toggling `hidden` on the ancestor panel.
      const observer = new MutationObserver(() => {
        if (isPanelVisible()) {
          show(0);
          startAutoRotate();
        } else {
          stopAutoRotate();
        }
      });
      observer.observe(panel, { attributes: true, attributeFilter: ["hidden"] });
    }

    if (isPanelVisible()) {
      startAutoRotate();
    }
  });
</script>
