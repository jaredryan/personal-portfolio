---
import { Icon } from "astro-icon/components";

interface Props {
  images: string[];
  alt: string;
  autoRotateMs?: number;
}

const { images, alt, autoRotateMs = 6000 } = Astro.props;
---
<div class="carousel" data-carousel data-autorotate-ms={autoRotateMs}>
  <div class="carousel__viewport">
    {images.map((src, index) => (
      <img
        src={src}
        alt={`${alt} — screenshot ${index + 1} of ${images.length}`}
        class="carousel__slide"
        data-slide-index={index}
        hidden={index !== 0}
        loading={index === 0 ? "eager" : "lazy"}
        width="960"
        height="600"
      />
    ))}
    <button type="button" class="carousel__expand" data-carousel-expand aria-label="Expand screenshot">
      <Icon name="lucide:arrow-up-right" aria-hidden="true" />
    </button>
  </div>

  <div class="carousel__lightbox" data-carousel-lightbox hidden>
    <button type="button" class="carousel__lightbox-backdrop" data-lightbox-backdrop aria-label="Close expanded view"></button>
    <div class="carousel__lightbox-panel" role="dialog" aria-modal="true" aria-label={`${alt} screenshot, expanded view`}>
      <button type="button" class="carousel__lightbox-close" data-lightbox-close aria-label="Close expanded view">
        <Icon name="lucide:x" aria-hidden="true" />
      </button>
      <img data-lightbox-img alt="" />
    </div>
  </div>

  <div class="carousel__controls">
    <button type="button" class="carousel__prev" aria-label="Previous screenshot">
      <Icon name="lucide:chevron-left" aria-hidden="true" />
    </button>
    <div class="carousel__dots" role="tablist" aria-label="Screenshot selector">
      {images.map((_, index) => (
        <button
          type="button"
          class="carousel__dot"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          aria-label={`Show screenshot ${index + 1}`}
          data-dot-index={index}
        />
      ))}
    </div>
    <button type="button" class="carousel__next" aria-label="Next screenshot">
      <Icon name="lucide:chevron-right" aria-hidden="true" />
    </button>
  </div>
</div>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .carousel__viewport {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    /* Slides are stacked with position: absolute below so the outgoing and
       incoming slide can overlap mid-transition — the viewport itself now
       owns the aspect ratio that used to live on the (in-flow) <img>. */
    aspect-ratio: 16 / 10;
  }

  .carousel__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateX(0);
    opacity: 1;
    transition: transform 260ms ease-out, opacity 260ms ease-out;
  }

  /* Shared offset used both as the incoming slide's starting point and the
     outgoing slide's ending point for a given direction, so two classes
     cover all four transition roles (next-enter/prev-exit share one,
     prev-enter/next-exit share the other). */
  .carousel__slide--from-right {
    transform: translateX(28px);
    opacity: 0;
  }

  .carousel__slide--from-left {
    transform: translateX(-28px);
    opacity: 0;
  }

  .carousel__expand {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    cursor: pointer;
  }

  .carousel__expand :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__expand:hover {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .carousel__lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .carousel__lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, black 65%, transparent);
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .carousel__lightbox-panel {
    position: relative;
    z-index: 1;
    max-width: min(1100px, 92vw);
    max-height: 88vh;
  }

  .carousel__lightbox-panel img {
    display: block;
    max-width: 100%;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .carousel__lightbox-close {
    position: absolute;
    top: calc(-1 * var(--space-4));
    right: calc(-1 * var(--space-4));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
  }

  .carousel__lightbox-close :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__lightbox-close:hover {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .carousel__prev,
  .carousel__next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    width: 2.25rem;
    height: 2.25rem;
    cursor: pointer;
  }

  .carousel__prev :global(svg),
  .carousel__next :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__dots {
    display: flex;
    gap: var(--space-2);
  }

  .carousel__dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    cursor: pointer;
    padding: 0;
  }

  .carousel__dot[aria-selected="true"] {
    background: var(--color-accent-coral);
    border-color: var(--color-accent-coral);
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ProjectsSection (Task 13) pre-renders all 5 project detail panels at once
  // and toggles each one's `hidden` attribute — it does not unmount/remount
  // this component. Without the visibility awareness below, every carousel's
  // setInterval would start immediately on page load and keep advancing while
  // its panel is hidden, so by the time a user opens a given project its
  // carousel would already be on some arbitrary slide, and 5 timers would be
  // running in the background for no visible benefit. Each carousel instead
  // only runs while the `[data-project-detail]` panel that contains it is
  // visible, and resets to slide 0 each time that panel becomes visible.
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLImageElement>(".carousel__slide"));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>(".carousel__dot"));
    const prevBtn = carousel.querySelector<HTMLButtonElement>(".carousel__prev");
    const nextBtn = carousel.querySelector<HTMLButtonElement>(".carousel__next");
    const autoRotateMs = Number(carousel.dataset.autorotateMs ?? 0);
    // Matches both the mobile detail panel (data-project-detail) and the
    // desktop spine+detail panel (data-project-detail-desktop) — the same
    // project can have a carousel instance rendered in each simultaneously,
    // only one of which is ever actually visible at a given viewport width.
    const panel = carousel.closest<HTMLElement>("[data-project-detail], [data-project-detail-desktop]");
    const expandBtn = carousel.querySelector<HTMLButtonElement>("[data-carousel-expand]");
    const lightbox = carousel.querySelector<HTMLElement>("[data-carousel-lightbox]");
    const lightboxImg = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const lightboxClose = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const lightboxBackdrop = lightbox?.querySelector<HTMLButtonElement>("[data-lightbox-backdrop]");
    let current = 0;
    let timerId: ReturnType<typeof setInterval> | undefined;

    function isPanelVisible(): boolean {
      return !panel || !panel.hidden;
    }

    // direction is "next"/"previous" for an explicit prev/next click, a
    // computed next/previous for dot clicks that skip forward or back, or
    // null when there's no meaningful direction (dot click landing on the
    // current slide, or the auto-reset to slide 0 when a project panel
    // opens) — null just crossfades via the hidden toggle, no slide.
    function show(index: number, direction: "next" | "previous" | null = null) {
      const nextIndex = (index + slides.length) % slides.length;
      if (nextIndex === current) return;

      const outgoing = slides[current];
      const incoming = slides[nextIndex];
      current = nextIndex;

      dots.forEach((dot, i) => {
        dot.setAttribute("aria-selected", String(i === current));
      });

      if (!direction) {
        outgoing.hidden = true;
        incoming.hidden = false;
        incoming.classList.remove("carousel__slide--from-right", "carousel__slide--from-left");
        return;
      }

      const enterClass = direction === "next" ? "carousel__slide--from-right" : "carousel__slide--from-left";
      const exitClass = direction === "next" ? "carousel__slide--from-left" : "carousel__slide--from-right";

      incoming.classList.remove("carousel__slide--from-right", "carousel__slide--from-left");
      incoming.hidden = false;
      incoming.classList.add(enterClass);
      // Force layout so the offset start-state is committed before removing
      // it triggers a transition — otherwise there's no "from" value to
      // animate from and the slide just appears already in place.
      void incoming.offsetWidth;
      incoming.classList.remove(enterClass);
      outgoing.classList.add(exitClass);

      outgoing.addEventListener(
        "transitionend",
        () => {
          outgoing.hidden = true;
          outgoing.classList.remove(exitClass);
        },
        { once: true },
      );
    }

    function startAutoRotate() {
      if (prefersReducedMotion || !autoRotateMs || slides.length < 2 || !isPanelVisible()) return;
      stopAutoRotate();
      timerId = setInterval(() => show(current + 1, "next"), autoRotateMs);
    }

    function stopAutoRotate() {
      if (timerId) clearInterval(timerId);
      timerId = undefined;
    }

    function onLightboxKeydown(event: KeyboardEvent) {
      if (event.key === "Escape") closeLightbox();
    }

    function openLightbox() {
      const activeSlide = slides[current];
      if (!lightbox || !lightboxImg || !activeSlide) return;
      lightboxImg.src = activeSlide.src;
      lightboxImg.alt = activeSlide.alt;
      lightbox.hidden = false;
      stopAutoRotate();
      document.addEventListener("keydown", onLightboxKeydown);
      lightboxClose?.focus();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.removeEventListener("keydown", onLightboxKeydown);
      startAutoRotate();
      expandBtn?.focus();
    }

    expandBtn?.addEventListener("click", openLightbox);
    lightboxClose?.addEventListener("click", closeLightbox);
    lightboxBackdrop?.addEventListener("click", closeLightbox);

    prevBtn?.addEventListener("click", () => {
      show(current - 1, "previous");
      startAutoRotate();
    });
    nextBtn?.addEventListener("click", () => {
      show(current + 1, "next");
      startAutoRotate();
    });
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        // Infer direction from index so jumping ahead/back several slides
        // via a dot still slides the expected way; landing on the current
        // dot is a no-op inside show() regardless.
        show(i, i > current ? "next" : i < current ? "previous" : null);
        startAutoRotate();
      });
    });

    carousel.addEventListener("mouseenter", stopAutoRotate);
    carousel.addEventListener("mouseleave", startAutoRotate);
    carousel.addEventListener("focusin", stopAutoRotate);
    carousel.addEventListener("focusout", startAutoRotate);

    if (panel) {
      // React to ProjectsSection toggling `hidden` on the ancestor panel.
      const observer = new MutationObserver(() => {
        if (isPanelVisible()) {
          show(0);
          startAutoRotate();
        } else {
          stopAutoRotate();
        }
      });
      observer.observe(panel, { attributes: true, attributeFilter: ["hidden"] });
    }

    if (isPanelVisible()) {
      startAutoRotate();
    }
  });
</script>
