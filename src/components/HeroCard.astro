---
import { Icon } from "astro-icon/components";
import { profile } from "../data/profile";
import ThemeToggle from "./ThemeToggle.astro";
import TypewriterTicker from "./TypewriterTicker.astro";
---
<article class="hero-card">
  <div class="hero-card__top">
    <div>
      <h1>{profile.name}</h1>
      <p class="hero-card__role">{profile.role}</p>
    </div>
    <ThemeToggle />
  </div>

  {profile.heroParagraphs.map((paragraph) => (
    <p class="hero-card__paragraph prose">{paragraph}</p>
  ))}

  <div class="hero-card__actions">
    <a class="hero-card__resume" href={profile.links.resume} download>
      <Icon name="lucide:download" aria-hidden="true" />
      Resume
    </a>
    <a class="hero-card__icon-btn" href={profile.links.email} aria-label="Email Jared Ryan">
      <Icon name="lucide:mail" aria-hidden="true" />
    </a>
    <a class="hero-card__icon-btn" href={profile.links.github} target="_blank" rel="noreferrer" aria-label="Jared Ryan on GitHub">
      <Icon name="simple-icons:github" aria-hidden="true" />
    </a>
    {profile.links.linkedin && (
      <a class="hero-card__icon-btn" href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="Jared Ryan on LinkedIn">
        <Icon name="simple-icons:linkedin" aria-hidden="true" />
      </a>
    )}
  </div>

  <TypewriterTicker label={profile.currentlyLabel} lines={profile.currentlyLines} />
</article>

<style>
  .hero-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .hero-card__role {
    margin-top: var(--space-1);
    color: var(--color-primary);
    font-weight: 600;
  }

  .hero-card__paragraph {
    color: var(--color-text-muted);
  }

  .hero-card__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-card__resume {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    text-decoration: none;
    color: white;
    font-weight: 600;
  }

  /* Icon size matches ThemeToggle's and the bento expand icons — one
     consistent icon scale across the whole page, independent of each
     control's own hit-target size. */
  .hero-card__resume :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .hero-card__resume:hover {
    background: var(--color-accent-teal);
    border-color: var(--color-accent-teal);
  }

  .hero-card__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
  }

  .hero-card__icon-btn :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .hero-card__icon-btn:hover,
  .hero-card__icon-btn:focus-visible {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }
</style>
