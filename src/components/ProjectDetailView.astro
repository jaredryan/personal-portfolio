---
import type { Project } from "../data/projects";
import PillList from "./PillList.astro";
import ProjectCarousel from "./ProjectCarousel.astro";

interface Props {
  project: Project;
  headingId: string;
  /** h2 for the mobile detail view (nested directly under the page's own
   * h2 "Projects" — matches existing, unchanged mobile markup). h3 for the
   * desktop/tablet showcase, matching Experience's per-item h3 under its
   * own page h2. */
  headingTag?: "h2" | "h3";
}

const { project, headingId, headingTag = "h2" } = Astro.props;
const Heading = headingTag;

const linkButtonClass: Record<Project["links"][number]["kind"], string> = {
  demo: "btn btn--primary",
  github: "btn btn--secondary",
  private: "btn btn--quiet",
  request: "btn btn--quiet",
};
---
<div class="project-detail__layout">
  <div class="project-detail__header">
    <div class="project-detail__intro">
      <Heading id={headingId} tabindex="-1">{project.title}</Heading>
      <p class="project-detail__oneliner prose">{project.oneLiner}</p>
    </div>

    <div class="project-detail__links">
      {project.links.map((link) => (
        link.href ? (
          <a class={linkButtonClass[link.kind]} href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ) : (
          <span class={linkButtonClass[link.kind]} aria-disabled="true">{link.label}</span>
        )
      ))}
    </div>
  </div>

  <div class="project-detail__main">
    <div class="project-detail__media">
      <ProjectCarousel
        images={[project.screenshots.cover, ...project.screenshots.images]}
        alt={project.title}
        icon={project.icon}
        autoRotateMs={0}
        playableEmbedUrl={project.playableEmbedUrl}
        playableLabel={project.playableLabel}
        playableIframeTitle={project.playableIframeTitle}
      />
    </div>

    <div class="project-detail__copy">
      <div class="project-detail__editorial">
        <p class="eyebrow">Built</p>
        <p>{project.built}</p>
      </div>
      <div class="project-detail__editorial">
        <p class="eyebrow">Interesting because</p>
        <p>{project.interestingBecause}</p>
      </div>
      <div class="project-detail__editorial">
        <p class="eyebrow">Stack</p>
        <PillList pills={project.detailPills} variant="detail" />
      </div>
    </div>
  </div>
</div>

<style>
  .project-detail__layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Centered by default (mobile/stacked) — on a narrow single-column
     screen, a left-hugging title/one-liner with a wall of empty space
     beside it reads as unfinished. Switches to left-aligned + a
     title/actions row once the two-column showcase kicks in below, where
     the composition uses the full page width. */
  .project-detail__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .project-detail__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: center;
    text-align: center;
  }

  .project-detail__intro h2,
  .project-detail__intro h3 {
    margin: 0;
  }

  .project-detail__oneliner {
    color: var(--color-text-muted);
  }

  .project-detail__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .project-detail__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .project-detail__media {
    width: 100%;
  }

  .project-detail__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    width: 100%;
  }

  .project-detail__editorial p:last-child {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .project-detail__editorial :global(.pill-list) {
    margin-top: var(--space-1);
  }

  /* Stack's label needs its own margin-bottom (rather than relying on the
     pill-list's margin-top, as Built/Interesting because do with their
     paragraph's margin-top) — a row of pills doesn't read with the same
     visual gap as a text paragraph at the same margin value, so the two
     ended up looking uneven. 6px was the closest visual match. */
  .project-detail__editorial:last-child .eyebrow {
    margin-bottom: 6px;
  }

  /* Two-column once there's enough room for a 350px media column and a
     400px copy column side by side (350+400+24 gap ≈ 774px) — below that,
     stack. Also switches the header from a centered stack (title, one-
     liner, actions) to a row with actions aligned top-right. */
  @media (min-width: 800px) {
    .project-detail__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .project-detail__intro {
      align-items: flex-start;
      text-align: left;
    }

    .project-detail__links {
      flex-shrink: 0;
      flex-wrap: nowrap;
      justify-content: flex-start;
    }

    .project-detail__main {
      flex-direction: row;
      align-items: flex-start;
    }

    .project-detail__media {
      width: 50%;
      flex-shrink: 0;
    }

    .project-detail__copy {
      flex: 1;
      min-width: 280px;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn--primary {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .btn--primary:hover {
    background: var(--color-accent-teal);
    border-color: var(--color-accent-teal);
  }

  .btn--secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .btn--secondary:hover {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .btn--quiet {
    background: var(--color-surface-alt);
    border-color: var(--color-border);
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 400;
    cursor: default;
  }
</style>
