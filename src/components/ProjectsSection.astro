---
import { Icon } from "astro-icon/components";
import type { Project } from "../data/projects";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContactDrawer from "./ContactDrawer.astro";
import ContactTrigger from "./ContactTrigger.astro";
import PageHeader from "./PageHeader.astro";
import ProjectDetailView from "./ProjectDetailView.astro";
import ProjectPagination from "./ProjectPagination.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Curated display order for the bento grid only — alternates the three
// pale/lower-contrast covers (Campfire, Ryan Legal PC, LPA Tracker) with the
// three darker, higher-contrast ones (the games) so the grid doesn't cluster
// same-toned tiles next to each other. Ryan Legal PC also sits deliberately
// in the first half, ahead of two of the three games, to read as real
// professional/client work rather than trailing behind the game projects.
// Everything else (detail view, deep links, breadcrumb) keys off slug, so
// this order has no effect elsewhere.
const gridOrder = [
  "campfire", "when-bunnies-attack", "ryan-legal-pc",
  "nest-invaders", "lpa-tracker", "unity-roguelike",
];
const gridProjects = gridOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is Project => Boolean(p));
---
<section class="projects-section page-shell" aria-label="Projects">
  <div id="projects-grid-view">
    <PageHeader
      breadcrumbLabel="Projects"
      eyebrow="Projects"
      heading="What I’ve built lately"
      headingId="projects-heading"
      icon="lucide:layout-grid"
    />

    <!-- Compact horizontal selector — mirrors BentoDashboard's project-preview
         thumb row (same icon-tile-on-accent-color recipe), but only visible
         at the narrow width where .projects-bento below becomes a swipeable
         rail (see that media query). Its own script keeps aria-pressed in
         sync with whichever tile is currently snapped/centered as the user
         swipes, so it doubles as both a jump-to-project control and a "you
         are on card N of 6" indicator while swiping. -->
    <div class="projects-rail-nav" role="group" aria-label="Jump to project">
      {gridProjects.map((project, index) => (
        <button
          type="button"
          class="projects-rail-nav__dot"
          data-rail-target={project.slug}
          aria-pressed={index === 0 ? "true" : "false"}
          aria-label={`Show ${project.title}`}
          style={{ "--dot-accent": project.accentColor, "--dot-accent-dark": project.accentColorDark }}
        >
          <Icon name={project.icon} aria-hidden="true" is:inline />
        </button>
      ))}
    </div>

    <!-- Bento grid: one tile per project. 6 divides cleanly into 2 or 3
         columns on its own, so there's no filler tile needed here. -->
    <div class="projects-bento">
      {gridProjects.map((project) => (
        <button
          type="button"
          class="project-tile"
          data-project-link={project.slug}
          aria-label={`View ${project.title}`}
        >
          <img
            src={project.screenshots.cover}
            alt=""
            width="480"
            height="300"
            loading="lazy"
          />
          <span class="project-tile__body">
            <span class="project-tile__title">{project.title}</span>
            <span class="project-tile__oneliner">{project.oneLiner}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div id="projects-detail-view" hidden>
    {projects.map((project, index) => {
      const total = projects.length;
      const prevProject = projects[(index - 1 + total) % total];
      const nextProject = projects[(index + 1) % total];
      return (
        <div
          class="project-detail"
          id={`project-detail-${project.slug}`}
          data-project-detail={project.slug}
          aria-labelledby={`project-detail-heading-${project.slug}`}
          hidden
        >
          <div class="page-utility-row">
            <Breadcrumbs
              trail={[
                { label: "Dashboard", href: "/" },
                { label: "Projects", href: "/projects/", clearProject: true },
                { label: project.title },
              ]}
            />
            <ContactTrigger />
          </div>
          <ProjectDetailView project={project} headingId={`project-detail-heading-${project.slug}`} />
          <ProjectPagination
            prevSlug={prevProject.slug}
            prevTitle={prevProject.title}
            nextSlug={nextProject.slug}
            nextTitle={nextProject.title}
            currentTitle={project.title}
            isFirst={index === 0}
            isLast={index === total - 1}
            position={index + 1}
            total={total}
          />
        </div>
      );
    })}
  </div>

  <ContactDrawer currentPage="projects" />
</section>

<style>
  .projects-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  /* Below the 2-column breakpoint, replace the vertical card stack with a
     native horizontal scroll-snap rail. Centered peek, not edge-aligned:
     padding-inline on the scroll container reserves as much space on each
     side as a card's own margin (see the project-tile flex-basis below),
     so scroll-snap-align: center can settle every card — including the
     first and last — dead center in the viewport, with an equal sliver of
     its neighbor(s) showing on both sides. No dots/arrows needed here for
     the swipe itself (native scroll-snap paging handles that); the
     .projects-rail-nav row above provides the "which of 6" indicator and
     jump targets instead. Order is untouched — same `gridProjects` array,
     just laid out horizontally instead of stacked. */
  @media (max-width: 699.98px) {
    .projects-bento {
      display: flex;
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 7.5%;
      padding-inline: 7.5%;
      -webkit-overflow-scrolling: touch;
      /* Full-bleed breakout: .page-shell (global.css) centers this section
         in a width capped short of the viewport by its own 2rem gutter, so
         without this the peeking neighbor card ran out of room and hit
         plain page background a bit before the actual screen edge instead
         of continuing to it. margin-inline: 50% - 50vw re-centers this
         element on the viewport itself rather than the page-shell, and
         width: 100vw then lets it span edge to edge — the standard
         "break out of a centered container" trick. scroll/padding-inline
         above now resolve against that full 100vw, so the peek still
         reads the same, just anchored to the true edge. */
      margin-inline: calc(50% - 50vw);
      width: 100vw;
    }

    .projects-bento .project-tile {
      flex: 0 0 100%;
      scroll-snap-align: center;
    }
  }

  @media (max-width: 580px) {
    .projects-bento {
      scroll-padding-inline: 5%;
      padding-inline: 5%;
      gap: var(--space-2);
    }
  }

  @media (min-width: 700px) {
    .projects-bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .projects-bento {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Hidden except at the same narrow width the rail above applies at —
     doesn't make sense as a "jump to card" control once .projects-bento is
     back to a static multi-column grid. */
  .projects-rail-nav {
    display: none;
  }

  @media (max-width: 699.98px) {
    .projects-rail-nav {
      display: flex;
      flex-direction: row;
      gap: var(--space-1);
      margin-bottom: var(--space-4);
    }
  }

  /* Same per-project accentColor/accentColorDark recipe as
     ProjectsPreview.astro's own thumb row (BentoDashboard) — full-saturation
     icon over a light color-mix tint, so this reads as the same visual
     language rather than a new one-off control. flex + a min/max-width band
     (rather than the even-division grid this used to be) keeps each dot a
     sensible tap-target size regardless of how wide the page-shell is —
     grid's minmax(0, 1fr) tracks let every dot balloon to 1/6 of the full
     page width, several times larger than ProjectsPreview.astro's own thumb
     row ever gets. Unconditional (not scoped to a media query) since this
     row is already display:none above 699.98px. */
  .projects-rail-nav__dot {
    aspect-ratio: 1;
    flex: 1 1 0;
    min-width: 36px;
    max-width: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--dot-accent) 45%, transparent);
    border-radius: var(--radius-sm);
    padding: 0;
    background: color-mix(in srgb, var(--dot-accent) 10%, var(--color-surface));
    color: var(--dot-accent);
    cursor: pointer;
  }

  :global([data-theme="dark"]) .projects-rail-nav__dot {
    border-color: color-mix(in srgb, var(--dot-accent-dark) 45%, transparent);
    background: color-mix(in srgb, var(--dot-accent-dark) 20%, var(--color-surface));
    color: var(--dot-accent-dark);
  }

  .projects-rail-nav__dot :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .projects-rail-nav__dot[aria-pressed="true"] {
    outline: 2px solid var(--color-accent-coral);
    outline-offset: 1px;
  }

  .projects-rail-nav__dot:not([aria-pressed="true"]):hover,
  .projects-rail-nav__dot:not([aria-pressed="true"]):focus-visible {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
    color: var(--color-accent-teal);
  }

  .project-tile {
    width: 100%;
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
  }

  .project-tile:hover,
  .project-tile:focus-visible {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .project-tile img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    transition: filter 180ms ease;
  }

  /* Extends the hover/focus feedback to the image too, so the whole tile
     reacts as one unit instead of just the text panel below it — a plain
     brightness dim rather than a color overlay, so it reads consistently
     whether the screenshot is pale (Campfire, LPA Tracker) or dark. */
  .project-tile:hover img,
  .project-tile:focus-visible img {
    filter: brightness(0.92);
  }

  /* Dark mode's --color-surface-alt is lighter than --color-surface (see
     tokens.css), so the text panel already lightens on hover there —
     darkening the image on top of that would move the two halves of the
     tile in opposite directions. Brightening instead keeps both halves
     moving the same way, matching the "both darken together" cohesion
     light mode already has. */
  :global([data-theme="dark"]) .project-tile:hover img,
  :global([data-theme="dark"]) .project-tile:focus-visible img {
    filter: brightness(1.1);
  }

  .project-tile__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
  }

  .project-tile__title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
  }

  .project-tile__oneliner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* "Spacious" viewport mode (see global.css) — the breadcrumb/contact row
     stays pinned at the top where wayfinding belongs, the bento grid (or
     selected project) below it centers in the leftover vertical space.
     One unified block now instead of the old width-bounded pair — both the
     grid and every detail panel share the same structure, so there's no
     longer a separate desktop tree that needed its own centering rules. */
  @media (min-width: 760px) and (min-height: 850px) {
    .projects-section {
      display: flex;
      flex-direction: column;
    }

    #projects-grid-view,
    #projects-detail-view,
    .project-detail {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .projects-bento {
      flex: 1;
      align-content: center;
    }

    /* .project-detail__layout is ProjectDetailView.astro's own root, hence
       :global() — this file doesn't own that class. */
    .project-detail :global(.project-detail__layout) {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>

<script>
  import { clearSectionState, getQueryParam, setSectionState } from "../utils/urlState";
  import { playEnterAnimation } from "../utils/motion";
  import { moveFocus } from "../utils/focus";

  const gridView = document.getElementById("projects-grid-view");
  const detailView = document.getElementById("projects-detail-view");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-project-detail]");
  // Matches both the bento grid tiles and ProjectPagination's prev/next
  // buttons — both carry this same attribute, so one wiring pass covers
  // every way a user can navigate to a project.
  const projectLinkButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-link]");
  const clearLinks = document.querySelectorAll<HTMLAnchorElement>("[data-clear-project]");

  // Keeps .projects-rail-nav's aria-pressed dot in sync with whichever
  // .project-tile is currently snapped/centered in the swipeable rail (only
  // actually a rail below 699.98px — see that media query — but harmless to
  // run unconditionally at any width, since .projects-bento just isn't a
  // scroll container above that width and the observer never fires). An
  // IntersectionObserver rooted at the rail itself, rather than tracking
  // scroll position by hand, since scroll-snap already guarantees one tile
  // settles at >=50% visible and this only needs to know which one.
  const railNav = document.querySelector<HTMLElement>(".projects-rail-nav");
  const railDots = railNav ? Array.from(railNav.querySelectorAll<HTMLButtonElement>("[data-rail-target]")) : [];
  const bento = document.querySelector<HTMLElement>(".projects-bento");
  const bentoTiles = bento ? Array.from(bento.querySelectorAll<HTMLElement>("[data-project-link]")) : [];

  if (bento && railDots.length && bentoTiles.length) {
    const railObserver = new IntersectionObserver(
      (entries) => {
        const mostVisible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!mostVisible) return;
        const slug = (mostVisible.target as HTMLElement).dataset.projectLink;
        railDots.forEach((dot) => {
          dot.setAttribute("aria-pressed", String(dot.dataset.railTarget === slug));
        });
      },
      { root: bento, threshold: [0.5, 0.6, 0.7, 0.8, 0.9, 1] },
    );
    bentoTiles.forEach((tile) => railObserver.observe(tile));

    railDots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const slug = dot.dataset.railTarget;
        const target = bentoTiles.find((tile) => tile.dataset.projectLink === slug);
        if (!target) return;
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        target.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", inline: "center", block: "nearest" });
      });
    });
  }

  function showProject(slug: string, focusPanel = false) {
    const panel = document.getElementById(`project-detail-${slug}`);
    if (!panel) return;
    if (gridView) gridView.hidden = true;
    if (detailView) detailView.hidden = false;
    detailPanels.forEach((p) => {
      p.hidden = p.dataset.projectDetail !== slug;
    });
    // Only animate on a genuine user click (focusPanel), not on initial
    // page load/URL sync — the static HTML should just appear on first paint.
    if (focusPanel) playEnterAnimation(panel);
    if (focusPanel) {
      // Focus the heading itself, not the whole panel — a small, meaningful
      // target instead of a page-sized container, so any focus-visible ring
      // stays localized. Scroll is handled separately below (not via
      // scrollIntoView, which either landed below the screenshot in the
      // single-column layout or left the breadcrumb at the viewport edge).
      const heading = document.getElementById(`project-detail-heading-${slug}`);
      if (heading) moveFocus(heading);
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      requestAnimationFrame(() => {
        window.scrollTo({ top: 0, left: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
      });
    }
  }

  function showGrid(focusHeading = false) {
    if (gridView) gridView.hidden = false;
    if (detailView) detailView.hidden = true;
    detailPanels.forEach((p) => {
      p.hidden = true;
    });
    // Only animate on a genuine "back to grid" click, not on initial
    // page load/URL sync.
    if (focusHeading && gridView) playEnterAnimation(gridView);
    if (focusHeading) {
      // Returning to the grid should reset to a clean top-of-page view, not
      // scrollIntoView the heading specifically — that flush-aligns the
      // heading to the viewport's top edge and scrolls the breadcrumb above
      // it out of view, which reads as a stray partial scroll rather than a
      // natural "back to the grid" landing.
      const heading = document.querySelector<HTMLElement>("#projects-heading");
      window.scrollTo({ top: 0, behavior: "auto" });
      if (heading) moveFocus(heading);
    }
  }

  function syncFromUrl() {
    const slug = getQueryParam("project");
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.projectDetail);
    if (slug && validSlugs.includes(slug)) {
      showProject(slug);
    } else {
      showGrid();
    }
  }

  projectLinkButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const slug = button.dataset.projectLink;
      if (!slug) return;
      showProject(slug, true);
      setSectionState({ key: "project", value: slug });
    });
  });

  clearLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      showGrid(true);
      clearSectionState({ key: "project" });
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
