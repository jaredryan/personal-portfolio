---
import type { Project } from "../data/projects";
import Breadcrumbs from "./Breadcrumbs.astro";
import PillList from "./PillList.astro";
import ProjectCarousel from "./ProjectCarousel.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

const linkButtonClass: Record<Project["links"][number]["kind"], string> = {
  demo: "btn btn--primary",
  github: "btn btn--secondary",
  private: "btn btn--quiet",
  request: "btn btn--quiet",
};
---
<section class="projects-section page-shell" aria-labelledby="projects-heading">
  <div id="projects-grid-view">
    <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Projects" }]} />
    <h2 id="projects-heading" class="page-title" tabindex="-1">Projects</h2>

    <ul class="projects-grid">
      {projects.map((project) => (
        <li>
          <button type="button" class="project-card" data-project-link={project.slug}>
            <img
              src={project.screenshots.cover}
              alt={`${project.title} screenshot`}
              width="480"
              height="300"
              loading="lazy"
            />
            <span class="project-card__title">{project.title}</span>
            <span class="project-card__oneliner">{project.oneLiner}</span>
            <PillList pills={project.previewPills} />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div id="projects-detail-view" hidden>
    {projects.map((project) => (
      <div
        class="project-detail"
        id={`project-detail-${project.slug}`}
        data-project-detail={project.slug}
        aria-labelledby={`project-detail-heading-${project.slug}`}
        hidden
      >
        <Breadcrumbs
          trail={[
            { label: "Dashboard", href: "/" },
            { label: "Projects", href: "/projects", clearProject: true },
            { label: project.title },
          ]}
        />

        <div class="project-detail__layout">
          <div class="project-detail__media">
            <ProjectCarousel images={project.screenshots.images} alt={project.title} />
          </div>

          <div class="project-detail__content">
            <h2 id={`project-detail-heading-${project.slug}`} tabindex="-1">{project.title}</h2>
            <p class="project-detail__oneliner prose">{project.oneLiner}</p>

            <ul class="project-detail__bullets">
              {project.details.map((detail) => <li>{detail}</li>)}
            </ul>

            <PillList pills={project.detailPills} variant="detail" />

            <div class="project-detail__links">
              {project.links.map((link) => (
                link.href ? (
                  <a class={linkButtonClass[link.kind]} href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                ) : (
                  <span class={linkButtonClass[link.kind]} aria-disabled="true">{link.label}</span>
                )
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .projects-section {
    min-height: 100svh;
  }

  .projects-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .project-card {
    width: 100%;
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .project-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-card__title {
    font-weight: 700;
  }

  .project-card__oneliner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .project-detail__layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .project-detail__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-detail__content h2 {
    margin-bottom: var(--space-1);
  }

  .project-detail__bullets {
    padding-left: 1.2rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .project-detail__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn--primary {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .btn--primary:hover {
    background: var(--color-accent-teal);
    border-color: var(--color-accent-teal);
  }

  .btn--secondary {
    background: var(--color-surface);
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .btn--secondary:hover {
    border-color: var(--color-accent-teal);
    color: var(--color-accent-teal);
  }

  .btn--quiet {
    background: var(--color-surface-alt);
    border-color: var(--color-border);
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: 400;
    cursor: default;
  }

  /* Breakpoint derived from the two columns' own minimums, not picked by
     eye: media can shrink to 350px and content to 400px before either gets
     cramped, so the page-shell needs >= 350+400+24(gap) = 774px of content
     width, which happens at a viewport of ~840px (page-shell subtracts 64px
     of side padding at this width). Below that, single column; the media
     column's width constraint only applies inside this query, so it's free
     to go full-width again in the single-column layout. */
  @media (min-width: 840px) {
    .project-detail__layout {
      flex-direction: row;
      align-items: flex-start;
    }

    .project-detail__media {
      width: min(55%, 460px);
      min-width: 350px;
      flex-shrink: 1;
    }

    .project-detail__content {
      flex: 1;
      min-width: 400px;
    }
  }
</style>

<script>
  import { getQueryParam } from "../utils/urlState";

  const gridView = document.getElementById("projects-grid-view");
  const detailView = document.getElementById("projects-detail-view");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-project-detail]");
  const gridCards = document.querySelectorAll<HTMLButtonElement>("[data-project-link]");
  const clearLinks = document.querySelectorAll<HTMLAnchorElement>("[data-clear-project]");

  function showProject(slug: string, focusPanel = false) {
    const panel = document.getElementById(`project-detail-${slug}`);
    if (!panel) return;
    if (gridView) gridView.hidden = true;
    if (detailView) detailView.hidden = false;
    detailPanels.forEach((p) => {
      p.hidden = p.dataset.projectDetail !== slug;
    });
    if (focusPanel) {
      // Focus the panel itself (aria-labelledby its own heading, so it
      // still announces sensibly) without letting focus() scroll on its
      // own, then explicitly scroll the whole page to the top on the next
      // frame — scrollIntoView on the heading landed below the screenshot
      // in the single-column (mobile) layout, and scrollIntoView on the
      // panel still only scrolled to the panel's own top, not the page's,
      // leaving the breadcrumb at the very edge of the viewport.
      if (!panel.hasAttribute("tabindex")) panel.setAttribute("tabindex", "-1");
      panel.focus({ preventScroll: true });
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      requestAnimationFrame(() => {
        window.scrollTo({ top: 0, left: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
      });
    }
  }

  function showGrid(focusHeading = false) {
    if (gridView) gridView.hidden = false;
    if (detailView) detailView.hidden = true;
    detailPanels.forEach((p) => {
      p.hidden = true;
    });
    if (focusHeading) {
      // Returning to the grid should reset to a clean top-of-page view, not
      // scrollIntoView the heading specifically — that flush-aligns the
      // heading to the viewport's top edge and scrolls the breadcrumb above
      // it out of view, which reads as a stray partial scroll rather than a
      // natural "back to the grid" landing.
      const heading = document.querySelector<HTMLElement>("#projects-heading");
      window.scrollTo({ top: 0, behavior: "auto" });
      if (heading) {
        if (!heading.hasAttribute("tabindex")) heading.setAttribute("tabindex", "-1");
        heading.focus({ preventScroll: true });
      }
    }
  }

  function syncFromUrl() {
    const slug = getQueryParam("project");
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.projectDetail);
    if (slug && validSlugs.includes(slug)) {
      showProject(slug);
    } else {
      showGrid();
    }
  }

  gridCards.forEach((card) => {
    card.addEventListener("click", () => {
      const slug = card.dataset.projectLink;
      if (!slug) return;
      showProject(slug, true);
      window.history.pushState(null, "", `?project=${slug}`);
    });
  });

  clearLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      showGrid(true);
      window.history.pushState(null, "", window.location.pathname);
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
