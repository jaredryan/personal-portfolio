---
import type { Project } from "../data/projects";
import Breadcrumbs from "./Breadcrumbs.astro";
import PillList from "./PillList.astro";
import ProjectDetailView from "./ProjectDetailView.astro";
import SpineNav, { type SpineItem } from "./SpineNav.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const defaultProjectSlug = projects[0]?.slug ?? "";

const spineItems: SpineItem[] = projects.map((project) => ({
  slug: project.slug,
  logoSrc: "/images/project-placeholder.png",
  line1: project.title,
  line2: project.shortDescriptor,
}));
---
<section class="projects-section page-shell" aria-label="Projects">
  <!-- Desktop/tablet-wide: spine + selected detail, mirroring the
       Experience page's interaction pattern. The breadcrumb here is
       static (Dashboard > Projects) and never appends the selected
       project — that contextual 3-level breadcrumb is mobile-only,
       preserved unchanged below. -->
  <div class="projects-desktop">
    <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Projects" }]} />
    <h2 id="projects-heading-desktop" class="page-title" tabindex="-1">Projects</h2>

    <div class="projects-layout">
      <SpineNav items={spineItems} defaultSlug={defaultProjectSlug} dataAttr="data-project-spine" ariaLabel="Project list" />

      <div class="projects-detail-desktop">
        {projects.map((project) => (
          <div
            class="projects-detail-desktop__panel"
            id={`project-detail-desktop-${project.slug}`}
            data-project-detail-desktop={project.slug}
            hidden={project.slug !== defaultProjectSlug}
          >
            <ProjectDetailView
              project={project}
              headingId={`project-detail-desktop-heading-${project.slug}`}
              headingTag="h3"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile: existing card grid <-> detail flow. Unchanged. -->
  <div class="projects-mobile">
    <div id="projects-grid-view">
      <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Projects" }]} />
      <h2 id="projects-heading" class="page-title" tabindex="-1">Projects</h2>

      <ul class="projects-grid">
        {projects.map((project) => (
          <li>
            <button type="button" class="project-card" data-project-link={project.slug}>
              <img
                src={project.screenshots.cover}
                alt={`${project.title} screenshot`}
                width="480"
                height="300"
                loading="lazy"
              />
              <span class="project-card__title">{project.title}</span>
              <span class="project-card__oneliner">{project.oneLiner}</span>
              <PillList pills={project.previewPills} />
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div id="projects-detail-view" hidden>
      {projects.map((project) => (
        <div
          class="project-detail"
          id={`project-detail-${project.slug}`}
          data-project-detail={project.slug}
          aria-labelledby={`project-detail-heading-${project.slug}`}
          hidden
        >
          <Breadcrumbs
            trail={[
              { label: "Dashboard", href: "/" },
              { label: "Projects", href: "/projects", clearProject: true },
              { label: project.title },
            ]}
          />
          <ProjectDetailView
            project={project}
            headingId={`project-detail-heading-${project.slug}`}
            headingTag="h2"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    min-height: 100svh;
  }

  /* 900px matches the Experience page's breakpoint — the two pages should
     switch to their desktop layout at the same viewport width, since
     they're meant to feel like siblings. */
  .projects-mobile {
    display: block;
  }

  .projects-desktop {
    display: none;
  }

  @media (min-width: 900px) {
    .projects-mobile {
      display: none;
    }

    .projects-desktop {
      display: block;
    }
  }

  /* The spine itself (.spine, .spine__item, etc.) is SpineNav.astro's own
     scoped component — shared verbatim with Experience's desktop spine, no
     duplicated styles here. */
  .projects-layout {
    display: grid;
    grid-template-columns: minmax(180px, 250px) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .projects-detail-desktop {
    min-width: 0;
  }

  .projects-detail-desktop__panel {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
  }

  .projects-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .project-card {
    width: 100%;
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    cursor: pointer;
  }

  .project-card:hover {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .project-card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .project-card__title {
    font-weight: 700;
  }

  .project-card__oneliner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>

<script>
  import { getQueryParam, setSectionState } from "../utils/urlState";
  import { playEnterAnimation } from "../utils/motion";

  // Deliberately not utils/focus.ts's moveFocusTo — that calls
  // scrollIntoView, which is fine for Experience's shorter panels but on
  // the desktop Projects detail (carousel stacked above a long content
  // block) it produced a jarring jump down to wherever the heading landed.
  // The spine stays in view when a different item is picked, so there's no
  // need to scroll at all — just move focus, don't move the page.
  function focusPanelNoScroll(selector: string) {
    const target = document.querySelector<HTMLElement>(selector);
    if (!target) return;
    if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
    target.focus({ preventScroll: true });
  }

  const gridView = document.getElementById("projects-grid-view");
  const detailView = document.getElementById("projects-detail-view");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-project-detail]");
  const gridCards = document.querySelectorAll<HTMLButtonElement>("[data-project-link]");
  const clearLinks = document.querySelectorAll<HTMLAnchorElement>("[data-clear-project]");

  function showProject(slug: string, focusPanel = false) {
    const panel = document.getElementById(`project-detail-${slug}`);
    if (!panel) return;
    if (gridView) gridView.hidden = true;
    if (detailView) detailView.hidden = false;
    detailPanels.forEach((p) => {
      p.hidden = p.dataset.projectDetail !== slug;
    });
    // Only animate on a genuine user click (focusPanel), not on initial
    // page load/URL sync — the static HTML should just appear on first paint.
    if (focusPanel) playEnterAnimation(panel);
    if (focusPanel) {
      // Focus the panel itself (aria-labelledby its own heading, so it
      // still announces sensibly) without letting focus() scroll on its
      // own, then explicitly scroll the whole page to the top on the next
      // frame — scrollIntoView on the heading landed below the screenshot
      // in the single-column (mobile) layout, and scrollIntoView on the
      // panel still only scrolled to the panel's own top, not the page's,
      // leaving the breadcrumb at the very edge of the viewport.
      if (!panel.hasAttribute("tabindex")) panel.setAttribute("tabindex", "-1");
      panel.focus({ preventScroll: true });
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      requestAnimationFrame(() => {
        window.scrollTo({ top: 0, left: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
      });
    }
  }

  function showGrid(focusHeading = false) {
    if (gridView) gridView.hidden = false;
    if (detailView) detailView.hidden = true;
    detailPanels.forEach((p) => {
      p.hidden = true;
    });
    // Only animate on a genuine "back to grid" click, not on initial
    // page load/URL sync.
    if (focusHeading && gridView) playEnterAnimation(gridView);
    if (focusHeading) {
      // Returning to the grid should reset to a clean top-of-page view, not
      // scrollIntoView the heading specifically — that flush-aligns the
      // heading to the viewport's top edge and scrolls the breadcrumb above
      // it out of view, which reads as a stray partial scroll rather than a
      // natural "back to the grid" landing.
      const heading = document.querySelector<HTMLElement>("#projects-heading");
      window.scrollTo({ top: 0, behavior: "auto" });
      if (heading) {
        if (!heading.hasAttribute("tabindex")) heading.setAttribute("tabindex", "-1");
        heading.focus({ preventScroll: true });
      }
    }
  }

  // Desktop spine + selected detail — same interaction model as
  // ExperienceSection.astro's selectRole(): every spine item and detail
  // panel gets synced together on every call, regardless of which one
  // triggered it, so the two never drift out of sync.
  const spineItems = document.querySelectorAll<HTMLButtonElement>("[data-project-spine]");
  const desktopDetailPanels = document.querySelectorAll<HTMLElement>("[data-project-detail-desktop]");
  const defaultProjectSlug = spineItems[0]?.dataset.projectSpine ?? "";

  function selectProjectDesktop(slug: string, focusPanel = false) {
    const validSlugs = Array.from(desktopDetailPanels).map((p) => p.dataset.projectDetailDesktop);
    const target = validSlugs.includes(slug) ? slug : defaultProjectSlug;

    spineItems.forEach((item) => {
      item.setAttribute("aria-pressed", String(item.dataset.projectSpine === target));
    });
    desktopDetailPanels.forEach((panel) => {
      const isTarget = panel.dataset.projectDetailDesktop === target;
      panel.hidden = !isTarget;
      // Only animate on a genuine user-initiated spine click (focusPanel),
      // not on initial page load/URL sync.
      if (isTarget && focusPanel) playEnterAnimation(panel);
    });

    if (focusPanel) focusPanelNoScroll(`#project-detail-desktop-heading-${target}`);
  }

  function syncFromUrl() {
    const slug = getQueryParam("project");
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.projectDetail);
    if (slug && validSlugs.includes(slug)) {
      showProject(slug);
    } else {
      showGrid();
    }
    selectProjectDesktop(slug ?? defaultProjectSlug);
  }

  gridCards.forEach((card) => {
    card.addEventListener("click", () => {
      const slug = card.dataset.projectLink;
      if (!slug) return;
      showProject(slug, true);
      window.history.pushState(null, "", `?project=${slug}`);
    });
  });

  clearLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      showGrid(true);
      window.history.pushState(null, "", window.location.pathname);
    });
  });

  spineItems.forEach((item) => {
    item.addEventListener("click", () => {
      const slug = item.dataset.projectSpine;
      if (!slug) return;
      selectProjectDesktop(slug, true);
      setSectionState({ key: "project", value: slug });
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
