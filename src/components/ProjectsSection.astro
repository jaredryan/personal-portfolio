---
import { Icon } from "astro-icon/components";
import type { Project } from "../data/projects";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContactDrawer from "./ContactDrawer.astro";
import ContactTrigger from "./ContactTrigger.astro";
import ProjectDetailView from "./ProjectDetailView.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Curated display order for the bento grid only — alternates the three
// pale/lower-contrast covers (Campfire, Ryan Legal PC, LPA Tracker) with the
// three darker, higher-contrast ones (the games) so the grid doesn't cluster
// same-toned tiles next to each other. Ryan Legal PC also sits deliberately
// in the first half, ahead of two of the three games, to read as real
// professional/client work rather than trailing behind the game projects.
// Everything else (detail view, deep links, breadcrumb) keys off slug, so
// this order has no effect elsewhere.
const gridOrder = [
  "campfire", "when-bunnies-attack", "ryan-legal-pc",
  "nest-invaders", "lpa-tracker", "unity-roguelike",
];
const gridProjects = gridOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p): p is Project => Boolean(p));
---
<section class="projects-section page-shell" aria-label="Projects">
  <div id="projects-grid-view">
    <div class="page-utility-row">
      <Breadcrumbs trail={[{ label: "Dashboard", href: "/" }, { label: "Projects" }]} />
      <ContactTrigger />
    </div>

    <div class="page-title-group">
      <Icon name="lucide:layout-grid" aria-hidden="true" />
      <h2 id="projects-heading" class="page-title" tabindex="-1">Projects</h2>
    </div>

    <!-- Bento grid: one tile per project. 6 divides cleanly into 2 or 3
         columns on its own, so there's no filler tile needed here. -->
    <div class="projects-bento">
      {gridProjects.map((project) => (
        <button
          type="button"
          class="project-tile"
          data-project-link={project.slug}
          aria-label={`View ${project.title}`}
        >
          <img
            src={project.screenshots.cover}
            alt=""
            width="480"
            height="300"
            loading="lazy"
          />
          <span class="project-tile__body">
            <span class="project-tile__title">{project.title}</span>
            <span class="project-tile__oneliner">{project.oneLiner}</span>
          </span>
        </button>
      ))}
    </div>
  </div>

  <div id="projects-detail-view" hidden>
    {projects.map((project) => (
      <div
        class="project-detail"
        id={`project-detail-${project.slug}`}
        data-project-detail={project.slug}
        aria-labelledby={`project-detail-heading-${project.slug}`}
        hidden
      >
        <div class="page-utility-row">
          <Breadcrumbs
            trail={[
              { label: "Dashboard", href: "/" },
              { label: "Projects", href: "/projects", clearProject: true },
              { label: project.title },
            ]}
          />
          <ContactTrigger />
        </div>
        <ProjectDetailView project={project} headingId={`project-detail-heading-${project.slug}`} />
      </div>
    ))}
  </div>

  <ContactDrawer currentPage="projects" />
</section>

<style>
  .projects-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 700px) {
    .projects-bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .projects-bento {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-tile {
    width: 100%;
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
  }

  .project-tile:hover,
  .project-tile:focus-visible {
    border-color: var(--color-accent-teal);
    background: var(--color-surface-alt);
  }

  .project-tile img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
    transition: filter 180ms ease;
  }

  /* Extends the hover/focus feedback to the image too, so the whole tile
     reacts as one unit instead of just the text panel below it — a plain
     brightness dim rather than a color overlay, so it reads consistently
     whether the screenshot is pale (Campfire, LPA Tracker) or dark. */
  .project-tile:hover img,
  .project-tile:focus-visible img {
    filter: brightness(0.92);
  }

  /* Dark mode's --color-surface-alt is lighter than --color-surface (see
     tokens.css), so the text panel already lightens on hover there —
     darkening the image on top of that would move the two halves of the
     tile in opposite directions. Brightening instead keeps both halves
     moving the same way, matching the "both darken together" cohesion
     light mode already has. */
  :global([data-theme="dark"]) .project-tile:hover img,
  :global([data-theme="dark"]) .project-tile:focus-visible img {
    filter: brightness(1.1);
  }

  .project-tile__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
  }

  .project-tile__title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
  }

  .project-tile__oneliner {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  /* "Spacious" viewport mode (see global.css) — the breadcrumb/contact row
     stays pinned at the top where wayfinding belongs, the bento grid (or
     selected project) below it centers in the leftover vertical space.
     One unified block now instead of the old width-bounded pair — both the
     grid and every detail panel share the same structure, so there's no
     longer a separate desktop tree that needed its own centering rules. */
  @media (min-width: 760px) and (min-height: 850px) {
    .projects-section {
      display: flex;
      flex-direction: column;
    }

    #projects-grid-view,
    #projects-detail-view,
    .project-detail {
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .projects-bento {
      flex: 1;
      align-content: center;
    }

    /* .project-detail__layout is ProjectDetailView.astro's own root, hence
       :global() — this file doesn't own that class. */
    .project-detail :global(.project-detail__layout) {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
</style>

<script>
  import { clearSectionState, getQueryParam, setSectionState } from "../utils/urlState";
  import { playEnterAnimation } from "../utils/motion";
  import { moveFocus } from "../utils/focus";

  const gridView = document.getElementById("projects-grid-view");
  const detailView = document.getElementById("projects-detail-view");
  const detailPanels = document.querySelectorAll<HTMLElement>("[data-project-detail]");
  const gridTiles = document.querySelectorAll<HTMLButtonElement>("[data-project-link]");
  const clearLinks = document.querySelectorAll<HTMLAnchorElement>("[data-clear-project]");

  function showProject(slug: string, focusPanel = false) {
    const panel = document.getElementById(`project-detail-${slug}`);
    if (!panel) return;
    if (gridView) gridView.hidden = true;
    if (detailView) detailView.hidden = false;
    detailPanels.forEach((p) => {
      p.hidden = p.dataset.projectDetail !== slug;
    });
    // Only animate on a genuine user click (focusPanel), not on initial
    // page load/URL sync — the static HTML should just appear on first paint.
    if (focusPanel) playEnterAnimation(panel);
    if (focusPanel) {
      // Focus the heading itself, not the whole panel — a small, meaningful
      // target instead of a page-sized container, so any focus-visible ring
      // stays localized. Scroll is handled separately below (not via
      // scrollIntoView, which either landed below the screenshot in the
      // single-column layout or left the breadcrumb at the viewport edge).
      const heading = document.getElementById(`project-detail-heading-${slug}`);
      if (heading) moveFocus(heading);
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      requestAnimationFrame(() => {
        window.scrollTo({ top: 0, left: 0, behavior: prefersReducedMotion ? "auto" : "smooth" });
      });
    }
  }

  function showGrid(focusHeading = false) {
    if (gridView) gridView.hidden = false;
    if (detailView) detailView.hidden = true;
    detailPanels.forEach((p) => {
      p.hidden = true;
    });
    // Only animate on a genuine "back to grid" click, not on initial
    // page load/URL sync.
    if (focusHeading && gridView) playEnterAnimation(gridView);
    if (focusHeading) {
      // Returning to the grid should reset to a clean top-of-page view, not
      // scrollIntoView the heading specifically — that flush-aligns the
      // heading to the viewport's top edge and scrolls the breadcrumb above
      // it out of view, which reads as a stray partial scroll rather than a
      // natural "back to the grid" landing.
      const heading = document.querySelector<HTMLElement>("#projects-heading");
      window.scrollTo({ top: 0, behavior: "auto" });
      if (heading) moveFocus(heading);
    }
  }

  function syncFromUrl() {
    const slug = getQueryParam("project");
    const validSlugs = Array.from(detailPanels).map((p) => p.dataset.projectDetail);
    if (slug && validSlugs.includes(slug)) {
      showProject(slug);
    } else {
      showGrid();
    }
  }

  gridTiles.forEach((tile) => {
    tile.addEventListener("click", () => {
      const slug = tile.dataset.projectLink;
      if (!slug) return;
      showProject(slug, true);
      setSectionState({ key: "project", value: slug });
    });
  });

  clearLinks.forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      showGrid(true);
      clearSectionState({ key: "project" });
    });
  });

  window.addEventListener("popstate", syncFromUrl);

  syncFromUrl();
</script>
