---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---
<BaseLayout
  title="Page not found | Jared Ryan"
  description="This page isn't here — head back to the dashboard."
>
  <main class="not-found">
    <div class="not-found__card">
      <div class="not-found__icon" aria-hidden="true">
        <Icon name="lucide:route-off" />
      </div>
      <h1>This page isn’t here.</h1>
      <p class="not-found__body">
        Could be a stale link, or an overenthusiastic route.
        <br />
        Either way, the dashboard is the safest path back.
      </p>
      <a class="btn btn--primary not-found__cta" href="/">Dashboard</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    /* No min-height needed — this element is <main> itself, and
       BaseLayout.astro's body { flex } already sizes <main> to fill
       exactly the space left over after the footer, footer-aware. An
       explicit 100svh here would override that and push the footer below
       the fold on a page with barely any content. */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .not-found__card {
    width: min(480px, 100%);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .not-found__icon {
    display: inline-flex;
    color: var(--color-primary);
  }

  .not-found__icon :global(svg) {
    width: 64px;
    height: 64px;
  }

  .not-found__body {
    color: var(--color-text-muted);
    max-width: 40ch;
  }

  /* .btn/.btn--primary (global.css) supply the base look; this page's CTA
     just wants a bit more breathing room and separation from the body copy
     above it than the shared recipe's default padding/spacing gives. */
  .not-found__cta {
    margin-top: var(--space-2);
    padding-inline: var(--space-6);
  }
</style>
